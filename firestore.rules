    }

    function canEditSet(setId) {
      return ownsSet(setId) || isSetCollaborator(setId);
    }

    function purgingSet(setId) {
      let path = /databases/$(database)/documents/quiz_sets/$(setId);
      return exists(path) && get(path).data.get('lifecycleState', '') == 'purging' &&
        get(path).data.get('purgeStartedAt', null) is timestamp;
    }

    function canPurgeSet(setId) {
      let path = /databases/$(database)/documents/quiz_sets/$(setId);
      return purgingSet(setId) && isApprovedTeacher() &&
        (get(path).data.ownerUid == request.auth.uid ||
          (isAdmin() && get(path).data.get('trashedAt', null) is timestamp &&
            request.time >= get(path).data.trashedAt + duration.value(30, 'd')));
    }

    function validAuthoritativeCounters(data) {
      return data.get('collaboratorCount', -1) is int &&
        data.get('collaboratorCount', -1) >= 0 &&
        data.get('collaboratorCount', -1) <= 20 &&
        data.get('imageCount', -1) is int &&
        data.get('imageCount', -1) >= 0;
    }

    function validSetLifecycleTransition(setId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let collaboratorMutation = after.get('collaboratorMutation', {});
      let imageMutation = after.get('imageMutation', {});
      let collaboratorTarget = /databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(collaboratorMutation.email);
      let imageTarget = /databases/$(database)/documents/images/$(setId)/q/$(imageMutation.key);
      return before.ownerUid == after.ownerUid && before.ownerEmail == after.ownerEmail &&
        validAuthoritativeCounters(before) && validAuthoritativeCounters(after) &&
        changed.hasOnly(['trashedAt', 'purgeStartedAt', 'lifecycleState', 'contentRevision',
          'collaboratorCount', 'collaboratorMutation', 'imageCount', 'imageMutation']) &&
        ((before.get('lifecycleState', 'active') == 'active' &&
            after.get('lifecycleState', 'active') == 'active' &&
            after.get('trashedAt', null) == before.get('trashedAt', null) &&
            after.get('purgeStartedAt', null) == before.get('purgeStartedAt', null) &&
            after.get('collaboratorCount', -1) == before.get('collaboratorCount', -1) &&
            after.get('collaboratorMutation', null) == before.get('collaboratorMutation', null) &&
            after.get('imageMutation', {}).action == 'add' &&
            after.get('imageMutation', {}).key is string && !exists(imageTarget) &&
            existsAfter(imageTarget) &&
            after.get('imageCount', -1) == before.get('imageCount', -1) + 1 &&
            canEditSetAfter(setId)) ||
          (before.get('lifecycleState', 'active') == 'active' &&
            after.get('lifecycleState', 'active') == 'active' &&
            after.get('trashedAt', null) == before.get('trashedAt', null) &&
            after.get('purgeStartedAt', null) == before.get('purgeStartedAt', null) &&
            after.get('collaboratorCount', -1) == before.get('collaboratorCount', -1) &&
            after.get('collaboratorMutation', null) == before.get('collaboratorMutation', null) &&
            after.get('imageMutation', {}).action == 'remove' &&
            after.get('imageMutation', {}).key is string && exists(imageTarget) &&
            !existsAfter(imageTarget) &&
            after.get('imageCount', -1) == before.get('imageCount', -1) - 1 &&
            canEditSetAfter(setId)) ||
          (before.get('lifecycleState', 'active') == 'active' &&
            after.get('lifecycleState', '') == 'trashed' &&
            after.get('trashedAt', null) is timestamp && after.trashedAt == request.time &&
            after.get('purgeStartedAt', null) == null &&
            after.get('collaboratorCount', -1) == before.get('collaboratorCount', -1) &&
            after.get('imageCount', -1) == before.get('imageCount', -1) &&
            after.get('collaboratorMutation', null) == before.get('collaboratorMutation', null) &&
            after.get('imageMutation', null) == before.get('imageMutation', null) &&
            ownsSet(setId) && validLifecyclePublicationBarrier(setId)) ||
          (before.get('lifecycleState', '') == 'trashed' &&
            after.get('lifecycleState', '') == 'active' &&
            !('trashedAt' in after) && after.get('purgeStartedAt', null) == null &&
            after.get('collaboratorCount', -1) == before.get('collaboratorCount', -1) &&
            after.get('imageCount', -1) == before.get('imageCount', -1) &&
            after.get('collaboratorMutation', null) == before.get('collaboratorMutation', null) &&
            after.get('imageMutation', null) == before.get('imageMutation', null) &&
            ownsSet(setId) && validLifecyclePublicationBarrier(setId)) ||
          (before.get('lifecycleState', '') == 'trashed' &&
            after.get('lifecycleState', '') == 'purging' &&
            counterMigrationUnlocked() &&
            before.get('purgeStartedAt', null) == null &&
            after.get('purgeStartedAt', null) is timestamp &&
            after.purgeStartedAt == request.time &&
            after.get('collaboratorCount', -1) is int && before.get('collaboratorCount', -1) is int &&
            after.get('collaboratorCount', -1) == before.get('collaboratorCount', -1) &&
            after.get('imageCount', -1) is int && before.get('imageCount', -1) is int &&
            after.get('imageCount', -1) == before.get('imageCount', -1) &&
            after.get('collaboratorMutation', null) == before.get('collaboratorMutation', null) &&
            after.get('imageMutation', null) == before.get('imageMutation', null) &&
            (ownsSet(setId) ||
              (isAdmin() && before.get('trashedAt', null) is timestamp &&
                request.time >= before.trashedAt + duration.value(30, 'd'))) &&
            validLifecyclePublicationBarrier(setId)) ||
          (before.get('lifecycleState', '') == 'purging' &&
            after.get('lifecycleState', '') == 'purging' &&
            before.get('purgeStartedAt', null) == after.get('purgeStartedAt', null) &&
            canPurgeSet(setId) &&
            ((after.get('collaboratorMutation', {}).action == 'purge-remove' &&
              collaboratorMutation.email is string && exists(collaboratorTarget) &&
              !existsAfter(collaboratorTarget) &&
              after.get('collaboratorCount', -1) == before.get('collaboratorCount', -1) - 1 &&
              after.get('imageCount', -1) == before.get('imageCount', -1) &&
              after.get('imageMutation', null) == before.get('imageMutation', null)) ||
             (after.get('imageMutation', {}).action == 'purge-remove' &&
              imageMutation.key is string && exists(imageTarget) && !existsAfter(imageTarget) &&
              after.get('imageCount', -1) == before.get('imageCount', -1) - 1 &&
              after.get('collaboratorCount', -1) == before.get('collaboratorCount', -1) &&
              after.get('collaboratorMutation', null) == before.get('collaboratorMutation', null)))));
    }

    function validPurgeCollaboratorDelete(setId, email) {
      let parentPath = /databases/$(database)/documents/quiz_sets/$(setId);
      let childPath = /databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(email);
      return canPurgeSet(setId) && exists(childPath) && !existsAfter(childPath) &&
        validCollaboratorShareAfter(setId, email, 'remove') &&
        validAuthoritativeCounters(get(parentPath).data) &&
        validAuthoritativeCounters(getAfter(parentPath).data) &&
        getAfter(parentPath).data.get('collaboratorCount', -1) ==
          get(parentPath).data.get('collaboratorCount', -1) - 1 &&
        getAfter(parentPath).data.get('collaboratorMutation', {}).email == email &&
        getAfter(parentPath).data.get('collaboratorMutation', {}).action == 'purge-remove';
    }

    function validPurgeImageDelete(setId, key) {
      let parentPath = /databases/$(database)/documents/quiz_sets/$(setId);
      let childPath = /databases/$(database)/documents/images/$(setId)/q/$(key);
      return canPurgeSet(setId) && exists(childPath) && !existsAfter(childPath) &&
        validAuthoritativeCounters(get(parentPath).data) &&
        validAuthoritativeCounters(getAfter(parentPath).data) &&
        getAfter(parentPath).data.get('imageCount', -1) ==
          get(parentPath).data.get('imageCount', -1) - 1 &&
        getAfter(parentPath).data.get('imageMutation', {}).key == key &&
        getAfter(parentPath).data.get('imageMutation', {}).action == 'purge-remove';
    }

    function validActiveImageCreate(setId, key) {
      let parentPath = /databases/$(database)/documents/quiz_sets/$(setId);
      let childPath = /databases/$(database)/documents/images/$(setId)/q/$(key);
      return exists(parentPath) && canEditSetAfter(setId) && activeSetAfter(setId) && !exists(childPath) &&
        existsAfter(childPath) && validAuthoritativeCounters(get(parentPath).data) &&
        validAuthoritativeCounters(getAfter(parentPath).data) &&
        getAfter(parentPath).data.get('imageCount', -1) == get(parentPath).data.get('imageCount', -1) + 1 &&
        getAfter(parentPath).data.get('imageMutation', {}).key == key &&
        getAfter(parentPath).data.get('imageMutation', {}).action == 'add';
    }

    function validActiveImageUpdate(setId, key) {
      let parentPath = /databases/$(database)/documents/quiz_sets/$(setId);
      let childPath = /databases/$(database)/documents/images/$(setId)/q/$(key);
      return exists(parentPath) && changesSetContentRevisionAfter(setId) && exists(childPath) && existsAfter(childPath) &&
        validAuthoritativeCounters(get(parentPath).data) &&
        validAuthoritativeCounters(getAfter(parentPath).data) &&
        get(parentPath).data.get('imageCount', -1) == getAfter(parentPath).data.get('imageCount', -1) &&
        get(parentPath).data.get('imageMutation', null) == getAfter(parentPath).data.get('imageMutation', null);
    }

    function validActiveImageDelete(setId, key) {
      let parentPath = /databases/$(database)/documents/quiz_sets/$(setId);
      let childPath = /databases/$(database)/documents/images/$(setId)/q/$(key);
      return exists(parentPath) && canEditSetAfter(setId) && activeSetAfter(setId) && exists(childPath) &&
        !existsAfter(childPath) && validAuthoritativeCounters(get(parentPath).data) &&
        validAuthoritativeCounters(getAfter(parentPath).data) &&
        getAfter(parentPath).data.get('imageCount', -1) == get(parentPath).data.get('imageCount', -1) - 1 &&
        getAfter(parentPath).data.get('imageMutation', {}).key == key &&
        getAfter(parentPath).data.get('imageMutation', {}).action == 'remove';
    }

    function activeSetAfter(setId) {
      let setPath = /databases/$(database)/documents/quiz_sets/$(setId);
      return existsAfter(setPath) &&
        (!('trashedAt' in getAfter(setPath).data) || getAfter(setPath).data.trashedAt == null) &&
        (!('purgeStartedAt' in getAfter(setPath).data) || getAfter(setPath).data.purgeStartedAt == null) &&
        (!('lifecycleState' in getAfter(setPath).data) || getAfter(setPath).data.lifecycleState == 'active');
    }

    function isSetCollaboratorAfter(setId) {
      return isApprovedTeacher() && activeSetAfter(setId) && exists(collaboratorPath(setId)) &&
        validStoredCollaboratorData(
          get(collaboratorPath(setId)).data,
          request.auth.token.email
        );
    }

    function canEditSetAfter(setId) {
      return ownsSetAfter(setId) || isSetCollaboratorAfter(setId);
    }

    function canStartSet(setId) {
      return isApprovedTeacher() && activeSet(setId) &&
        (ownsSet(setId) || isSetCollaborator(setId));
    }

    function canStartSetAfter(setId) {
      return activeSetAfter(setId) &&
        (ownsSetAfter(setId) || isSetCollaboratorAfter(setId));
    }

    function validCollaboratorData(email) {
      return validStoredCollaboratorData(request.resource.data, email) &&
        request.resource.data.addedByUid == request.auth.uid &&
        exists(/databases/$(database)/documents/teacher_allowlist/$(email)) &&
        get(/databases/$(database)/documents/teacher_allowlist/$(email)).data.enabled == true &&
        get(/databases/$(database)/documents/teacher_allowlist/$(email)).data.role in ['teacher', 'admin'];
    }

    function validCollaboratorCount(setId) {
      let before = resource.data.get('collaboratorCount', 0);
      let after = request.resource.data.get('collaboratorCount', 0);
      let mutation = request.resource.data.get('collaboratorMutation', {});
      let targetPath = /databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(mutation.email);
      return validAuthoritativeCounters(resource.data) &&
        validAuthoritativeCounters(request.resource.data) &&
        before is int && before >= 0 && before <= 20 &&
        after is int && after >= 0 && after <= 20 &&
        (after == before ||
          (after == before + 1 &&
            mutation.action == 'add' && mutation.email is string &&
            canonicalAllowanceId(mutation.email) && !exists(targetPath) &&
            existsAfter(targetPath) && getAfter(targetPath).data.email == mutation.email &&
            validCollaboratorShareAfter(setId, mutation.email, 'add')) ||
          (after == before - 1 &&
            mutation.action == 'remove' && mutation.email is string &&
            canonicalAllowanceId(mutation.email) && exists(targetPath) &&
            !existsAfter(targetPath) &&
            validCollaboratorShareAfter(setId, mutation.email, 'remove')));
    }

    function validCollaboratorMutation(setId, email, action) {
      let parentPath = /databases/$(database)/documents/quiz_sets/$(setId);
      let parent = getAfter(parentPath).data;
      let before = get(parentPath).data.get('collaboratorCount', 0);
      let after = parent.get('collaboratorCount', 0);
      return parent.get('collaboratorMutation', {}).email == email &&
        parent.get('collaboratorMutation', {}).action == action &&
        ((action == 'add' && after == before + 1) ||
          (action == 'remove' && after == before - 1));
    }

    function ownsSetAfter(setId) {
      return isApprovedTeacher() &&
        existsAfter(/databases/$(database)/documents/quiz_sets/$(setId)) &&
        getAfter(/databases/$(database)/documents/quiz_sets/$(setId)).data.ownerUid == request.auth.uid;
    }

    function changesSetContentRevisionAfter(setId) {
      let setPath = /databases/$(database)/documents/quiz_sets/$(setId);
      return canEditSetAfter(setId) &&
        (!exists(setPath) || activeSet(setId)) &&
        activeSetAfter(setId) &&
        getAfter(setPath).data.get('contentRevision', null) != null &&
        (!exists(setPath) ||
          getAfter(setPath).data.get('contentRevision', null) !=
            get(setPath).data.get('contentRevision', null));
    }

    function publicationPath(setId) {
      return /databases/$(database)/documents/published_quiz_sets/$(setId);
    }

    function publicationAuditPath(setId) {
      return /databases/$(database)/documents/published_quiz_audits/$(setId);
    }

    function publicationSourcePath(setId) {
      return /databases/$(database)/documents/quiz_sets/$(setId);
    }

    function publicationLifecycleLockPath(ownerUid) {
      return /databases/$(database)/documents/publication_lifecycle_locks/$(ownerUid);
    }

    function publicLifecycleGateOpen() {
      return !exists(
        /databases/$(database)/documents/publication_lifecycle_gates/current
      );
    }

    function visiblePublicationSourceIsActive(setId) {
      let sourcePath = publicationSourcePath(setId);
      let source = get(sourcePath).data;
      let allowancePath = /databases/$(database)/documents/teacher_allowances/$(source.ownerUid);
      let allowance = get(allowancePath).data;
      return publicLifecycleGateOpen() && exists(sourcePath) && source.keys().hasAll([
          'ownerUid', 'ownerEmail', 'lifecycleState'
        ]) && source.lifecycleState == 'active' &&
        source.get('trashedAt', null) == null && source.get('purgeStartedAt', null) == null &&
        exists(allowancePath) &&
        [allowance.uid, allowance.emailCanonical, allowance.status, allowance.enabled] ==
          [source.ownerUid, source.ownerEmail, 'active', true] &&
        allowance.role in ['teacher', 'admin'] &&
        !exists(publicationLifecycleLockPath(source.ownerUid));
    }

    function publicationImagePath(setId, key) {
      return /databases/$(database)/documents/published_quiz_sets/$(setId)/images/$(key);
    }

    function privateImagePath(setId, key) {
      return /databases/$(database)/documents/images/$(setId)/q/$(key);
    }

    function publicParentKeys() {
      return [
        'publicationId', 'sourceSetId', 'status', 'moderationStatus', 'revision',
        'title', 'description', 'authorDisplayName',
        'revealMode', 'limitSec', 'revealDelaySec', 'autoPause',
        'videoCount', 'questionCount', 'imageCount', 'publishedAt', 'updatedAt'
      ];
    }

    function publicBuildingKeys() {
      return [
        'publicationId', 'sourceSetId', 'status', 'moderationStatus', 'revision',
        'title', 'description', 'authorDisplayName',
        'revealMode', 'limitSec', 'revealDelaySec', 'autoPause',
        'videoCount', 'questionCount', 'imageCount', 'publishedAt', 'updatedAt',
        'buildToken', 'buildVideoCount', 'buildQuestionCount', 'buildImageCount',
        'buildMutation'
      ];
    }

    function validCanonicalPublicationId(value) {
      return value is string && value.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$');
    }

    function validPublicParentContent(data, setId) {
      return validCanonicalPublicationId(setId) &&
        data.publicationId == setId && data.sourceSetId == setId &&
        data.status in ['building', 'cancelled', 'published', 'withdrawn', 'moderated'] &&
        data.moderationStatus in ['clear', 'moderated'] &&
        ((data.status == 'moderated') == (data.moderationStatus == 'moderated')) &&
        data.revision is string && data.revision == data.revision.trim() &&
        data.revision.size() >= 1 && data.revision.size() <= 200 &&
        data.title is string && data.title == data.title.trim() &&
        data.title.size() >= 1 && data.title.size() <= 200 &&
        data.description is string && data.description == data.description.trim() &&
        data.description.size() <= 1000 &&
        validPublicAuthorLabel(data.authorDisplayName, '', '') &&
        data.revealMode in ['instant', 'timer', 'manual', 'never'] &&
        data.limitSec is int && data.limitSec >= 0 && data.limitSec <= 600 &&
        data.revealDelaySec is int && data.revealDelaySec >= 0 &&
        data.revealDelaySec <= 600 && data.autoPause is bool &&
        data.videoCount is int && data.videoCount >= 1 && data.videoCount <= 50 &&
        data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 500 &&
        data.imageCount is int && data.imageCount >= 0 &&
        (data.publishedAt == null || data.publishedAt is timestamp) &&
        data.updatedAt is timestamp &&
        (data.publishedAt == null || data.updatedAt >= data.publishedAt) &&
        (data.status in ['building', 'cancelled'] || data.publishedAt is timestamp);
    }

    function validPublicParentShape(data, setId) {
      return data.keys().hasAll(publicParentKeys()) &&
        data.keys().hasOnly(publicParentKeys()) &&
        validPublicParentContent(data, setId);
    }

    function validPublicBuildingShape(data, setId) {
      return data.keys().hasAll(publicParentKeys().concat([
          'buildToken', 'buildVideoCount', 'buildQuestionCount', 'buildImageCount'
        ])) &&
        data.keys().hasOnly(publicBuildingKeys()) &&
        data.status in ['building', 'cancelled'] && data.moderationStatus == 'clear' &&
        data.buildToken is string && data.buildToken.size() >= 1 &&
        data.buildToken.size() <= 200 &&
        data.buildVideoCount is int && data.buildVideoCount >= 0 &&
        data.buildQuestionCount is int && data.buildQuestionCount >= 0 &&
        data.buildImageCount is int && data.buildImageCount >= 0 &&
        (!('buildMutation' in data) ||
          (data.buildMutation is map &&
            data.buildMutation.keys().hasAll(['collection', 'key', 'action']) &&
            data.buildMutation.keys().hasOnly(['collection', 'key', 'action']) &&
            data.buildMutation.collection in ['videos', 'questions', 'images'] &&
            data.buildMutation.key is string && data.buildMutation.action == 'bind')) &&
        validPublicParentContent(data, setId);
    }

    function sourceRevision(data) {
      let revision = data.get('contentRevision', null);
      return revision is string ? revision.trim() :
        revision is int && revision >= 0 ? string(revision) :
        revision is timestamp
          ? string(revision.toMillis()) + ':' + string(revision.nanos())
          : '';
    }

    function validSourceOwnerAllowanceAfter(source) {
      let path = /databases/$(database)/documents/teacher_allowances/$(source.ownerUid);
      let allowance = getAfter(path).data;
      return existsAfter(path) &&
        [allowance.uid, allowance.emailCanonical, allowance.status, allowance.enabled] ==
          [source.ownerUid, source.ownerEmail, 'active', true] &&
        allowance.role in ['teacher', 'admin'] &&
        !existsAfter(publicationLifecycleLockPath(source.ownerUid));
    }

    function validActivePublicationSourceIdentityAfter(setId) {
      let path = publicationSourcePath(setId);
      let source = getAfter(path).data;
      return existsAfter(path) && source.ownerUid is string && source.ownerEmail is string &&
        source.ownerUid.size() >= 1 && canonicalAllowanceId(source.ownerEmail) &&
        'lifecycleState' in source && source.lifecycleState == 'active' &&
        source.get('trashedAt', null) == null && source.get('purgeStartedAt', null) == null &&
        sourceRevision(source).size() >= 1 && validSourceOwnerAllowanceAfter(source);
    }

    function validActivePublicationSourceAfter(setId) {
      let source = getAfter(publicationSourcePath(setId)).data;
      return validActivePublicationSourceIdentityAfter(setId) && validAuthoritativeCounters(source);
    }

    function validActivePublicationSourceIdentity(setId) {
      let path = publicationSourcePath(setId);
      let source = get(path).data;
      let allowancePath = /databases/$(database)/documents/teacher_allowances/$(source.ownerUid);
      let allowance = get(allowancePath).data;
      return exists(path) && exists(allowancePath) &&
        source.ownerUid is string && source.ownerUid.size() >= 1 &&
        source.ownerEmail is string && canonicalAllowanceId(source.ownerEmail) &&
        'lifecycleState' in source && source.lifecycleState == 'active' &&
        source.get('trashedAt', null) == null && source.get('purgeStartedAt', null) == null &&
        sourceRevision(source).size() >= 1 &&
        [allowance.uid, allowance.emailCanonical, allowance.status, allowance.enabled] ==
          [source.ownerUid, source.ownerEmail, 'active', true] &&
        allowance.role in ['teacher', 'admin'] &&
        !exists(publicationLifecycleLockPath(source.ownerUid));
    }

    function validActivePublicationSource(setId) {
      return validActivePublicationSourceIdentity(setId) &&
        validAuthoritativeCounters(get(publicationSourcePath(setId)).data);
    }

    function requesterOwnsPublicationSource(setId) {
      let source = get(publicationSourcePath(setId)).data;
      return isApprovedTeacher() && validActivePublicationSourceIdentity(setId) &&
        source.ownerUid == request.auth.uid && source.ownerEmail == request.auth.token.email;
    }

    function lifecycleOwnerMayAuditPublication(setId) {
      let path = publicationSourcePath(setId);
      return exists(path) && isApprovedTeacher() &&
        get(path).data.ownerUid == request.auth.uid &&
        get(path).data.ownerEmail == request.auth.token.email;
    }

    function validPublicationSourceMedia(data, source) {
      return (source.get('videos', null) is list &&
          data.videoCount == source.videos.size()) ||
        (!('videos' in source) && source.get('videoId', '') is string &&
          source.videoId.matches('^[A-Za-z0-9_-]{11}$') &&
          source.get('videoUrl', '') is string && source.videoUrl.size() >= 1 &&
          source.videoUrl.size() <= 2048 && source.get('questions', null) is list &&
          source.questions.size() >= 1 && source.questions.size() <= 500 &&
          data.videoCount == 1 && data.questionCount == source.questions.size());
    }

    function publicMatchesActiveSourceAfter(data, setId) {
      let source = getAfter(publicationSourcePath(setId)).data;
      let allowance = getAfter(
        /databases/$(database)/documents/teacher_allowances/$(source.ownerUid)
      ).data;
      return validActivePublicationSourceAfter(setId) &&
        validPublicAuthorLabel(data.authorDisplayName, source.ownerEmail, source.ownerUid) &&
        data.authorDisplayName == allowance.get('displayName', '') &&
        data.revision == sourceRevision(source) &&
        source.title is string && data.title == source.title.trim() &&
        source.get('description', '') is string &&
        data.description == source.get('description', '').trim() &&
        validPublicationSourceMedia(data, source) && source.get('settings', {}) is map &&
        data.revealMode == source.get('settings', {}).get('revealMode', 'timer') &&
        data.limitSec == source.get('settings', {}).get('limitSec', 20) &&
        data.revealDelaySec == source.get('settings', {}).get('revealDelaySec', 5) &&
        data.autoPause == source.get('settings', {}).get('autoPause', true) &&
        data.imageCount == source.imageCount;
    }

    function ownerAuthorMatchesAllowance(data, setId) {
      let source = get(publicationSourcePath(setId)).data;
      let allowance = get(
        /databases/$(database)/documents/teacher_allowances/$(source.ownerUid)
      ).data;
      return !(data.authorDisplayName in [source.ownerEmail, source.ownerUid]) &&
        data.authorDisplayName == allowance.get('displayName', '');
    }

    function validOwnerProjectionAfter(data, setId) {
      let sourcePath = publicationSourcePath(setId);
      let source = getAfter(sourcePath).data;
      let allowancePath = /databases/$(database)/documents/teacher_allowances/$(source.ownerUid);
      let allowance = getAfter(allowancePath).data;
      return verifiedEmail() && existsAfter(sourcePath) && existsAfter(allowancePath) &&
        source.ownerUid == request.auth.uid && source.ownerEmail == request.auth.token.email &&
        'lifecycleState' in source && source.lifecycleState == 'active' &&
        source.get('trashedAt', null) == null && source.get('purgeStartedAt', null) == null &&
        [allowance.uid, allowance.emailCanonical, allowance.status, allowance.enabled] ==
          [source.ownerUid, source.ownerEmail, 'active', true] &&
        !existsAfter(publicationLifecycleLockPath(source.ownerUid)) &&
        validAuthoritativeCounters(source) &&
        data.revision == sourceRevision(source) &&
        source.title is string && data.title == source.title.trim() &&
        source.get('description', '') is string &&
        data.description == source.get('description', '').trim() &&
        validPublicationSourceMedia(data, source) && source.get('settings', {}) is map &&
        data.revealMode == source.get('settings', {}).get('revealMode', 'timer') &&
        data.limitSec == source.get('settings', {}).get('limitSec', 20) &&
        data.revealDelaySec == source.get('settings', {}).get('revealDelaySec', 5) &&
        data.autoPause == source.get('settings', {}).get('autoPause', true) &&
        data.imageCount == source.imageCount &&
        !(data.authorDisplayName in [source.ownerEmail, source.ownerUid]) &&
        data.authorDisplayName == allowance.get('displayName', '');
    }

    function validOwnerPublicationLifecycleAfter(data, setId) {
      let sourcePath = publicationSourcePath(setId);
      let source = getAfter(sourcePath).data;
      let allowancePath = /databases/$(database)/documents/teacher_allowances/$(source.ownerUid);
      let allowance = getAfter(allowancePath).data;
      return verifiedEmail() && existsAfter(sourcePath) && existsAfter(allowancePath) &&
        source.ownerUid == request.auth.uid && source.ownerEmail == request.auth.token.email &&
        'lifecycleState' in source && source.lifecycleState == 'active' &&
        source.get('trashedAt', null) == null && source.get('purgeStartedAt', null) == null &&
        data.revision == sourceRevision(source) &&
        [allowance.uid, allowance.emailCanonical, allowance.status, allowance.enabled] ==
          [source.ownerUid, source.ownerEmail, 'active', true] &&
        !existsAfter(publicationLifecycleLockPath(source.ownerUid));
    }

    function validPublicBuildingStepShape(data, setId) {
      return data.keys().hasAll(publicParentKeys().concat([
          'buildToken', 'buildVideoCount', 'buildQuestionCount', 'buildImageCount',
          'buildMutation'
        ])) && data.keys().hasOnly(publicBuildingKeys()) &&
        data.publicationId == setId && data.sourceSetId == setId &&
        data.status == 'building' && data.moderationStatus == 'clear' &&
        data.revision is string && data.revision.size() >= 1 && data.revision.size() <= 200 &&
        data.buildToken is string && data.buildToken.size() >= 1 &&
        data.buildToken.size() <= 200 &&
        data.videoCount is int && data.videoCount >= 1 && data.videoCount <= 50 &&
        data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 500 &&
        data.imageCount is int && data.imageCount >= 0 &&
        data.buildVideoCount is int && data.buildVideoCount >= 0 &&
        data.buildVideoCount <= data.videoCount &&
        data.buildQuestionCount is int && data.buildQuestionCount >= 0 &&
        data.buildQuestionCount <= data.questionCount &&
        data.buildImageCount is int && data.buildImageCount >= 0 &&
        data.buildImageCount <= data.imageCount;
    }

    function publicContentUnchanged(before, after) {
      return after.diff(before).affectedKeys().hasOnly([
        'status', 'moderationStatus', 'publishedAt', 'updatedAt',
        'buildToken', 'buildVideoCount', 'buildQuestionCount', 'buildImageCount',
        'buildMutation'
      ]);
    }

    function publicationVideoPath(setId, key) {
      return /databases/$(database)/documents/published_quiz_sets/$(setId)/videos/$(key);
    }

    function publicationQuestionPath(setId, key) {
      return /databases/$(database)/documents/published_quiz_sets/$(setId)/questions/$(key);
    }

    function validPublicPartBinding(data, revision, buildToken) {
      return data.revision == revision && data.buildToken == buildToken &&
        data.schemaVersion == 1 &&
        data.revision is string && data.revision.size() >= 1 && data.revision.size() <= 200 &&
        data.buildToken is string && data.buildToken.size() >= 1 &&
        data.buildToken.size() <= 200;
    }

    function validPublicVideoPart(data, key, revision, buildToken) {
      return data is map &&
        data.keys().hasAll([
          'videoKey', 'videoId', 'videoUrl', 'startSec', 'endSec',
          'revision', 'schemaVersion', 'buildToken'
        ]) &&
        data.keys().hasOnly([
          'videoKey', 'videoId', 'videoUrl', 'startSec', 'endSec',
          'revision', 'schemaVersion', 'buildToken'
        ]) &&
        key.matches('^v(0|[1-9][0-9]*)$') && data.videoKey == key &&
        data.videoId is string && data.videoId.matches('^[A-Za-z0-9_-]{11}$') &&
        data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 2048 &&
        data.videoUrl.matches('^https://.*$') &&
        data.startSec is number && data.startSec >= 0 &&
        (data.endSec == null || (data.endSec is number && data.endSec > data.startSec)) &&
        validPublicPartBinding(data, revision, buildToken);
    }

    function validPublicQuestionPart(data, key, revision, buildToken) {
      let allowed = [
        'type', 't', 'text', 'choices', 'answer', 'answers', 'accept',
        'imgUp', 'imgUrl', 'explain', 'explainImgUp', 'explainImgUrl', 'limitSec',
        'questionKey', 'videoKey', 'revision', 'schemaVersion', 'buildToken'
      ];
      return data is map &&
        data.keys().hasAll([
          'type', 't', 'text', 'choices', 'answer',
          'questionKey', 'videoKey', 'revision', 'schemaVersion', 'buildToken'
        ]) && data.keys().hasOnly(allowed) &&
        key.matches('^v(0|[1-9][0-9]*)q(0|[1-9][0-9]*)$') &&
        data.videoKey.matches('^v(0|[1-9][0-9]*)$') &&
        key.matches('^' + data.videoKey + 'q(0|[1-9][0-9]*)$') &&
        data.questionKey == key && data.type in ['choice', 'multi', 'ox', 'short', 'long'] &&
        data.t is number && data.t >= 0 && data.text is string &&
        data.text == data.text.trim() && data.text.size() >= 1 && data.text.size() <= 1000 &&
        validChoiceList(data.choices) &&
        ((data.type in ['choice', 'multi'] && data.choices.size() >= 2) ||
          (data.type == 'ox' && data.choices.size() == 2) ||
          (data.type in ['short', 'long'] && data.choices.size() == 0)) &&
        data.answer is int &&
        ((data.choices.size() == 0 && data.answer == 0) ||
          (data.choices.size() > 0 && data.answer >= 0 && data.answer < data.choices.size())) &&
        ((data.type == 'multi' && 'answers' in data &&
            validMultiChoice(data.answers, data.choices) && !('accept' in data)) ||
          (data.type == 'short' && 'accept' in data && validAcceptList(data.accept) &&
            !('answers' in data)) ||
          (data.type in ['choice', 'ox', 'long'] &&
            !('answers' in data) && !('accept' in data))) &&
        (!('imgUp' in data) || data.imgUp is bool) &&
        (!('explainImgUp' in data) || data.explainImgUp is bool) &&
        (!('imgUrl' in data) || (data.imgUrl is string && data.imgUrl.size() >= 1 &&
          data.imgUrl.size() <= 2048 && data.imgUrl.matches('^https://.*$'))) &&
        (!('explainImgUrl' in data) || (data.explainImgUrl is string &&
          data.explainImgUrl.size() >= 1 && data.explainImgUrl.size() <= 2048 &&
          data.explainImgUrl.matches('^https://.*$'))) &&
        (!('explain' in data) || (data.explain is string && data.explain == data.explain.trim() &&
          data.explain.size() >= 1 && data.explain.size() <= 1000)) &&
        (!('limitSec' in data) || (data.limitSec is int &&
          data.limitSec >= 0 && data.limitSec <= 600)) &&
        validPublicPartBinding(data, revision, buildToken);
    }

    function validBuildMutation(data, collectionName, key) {
      return data is map && data.keys().hasAll(['collection', 'key', 'action']) &&
        data.keys().hasOnly(['collection', 'key', 'action']) &&
        data.collection == collectionName && data.key == key && data.action == 'bind';
    }

    function validBuildTargetRebind(path, buildToken) {
      return existsAfter(path) && (!exists(path) || get(path).data.get('buildToken', '') != buildToken);
    }

    function validBuildingCreate(setId) {
      let after = request.resource.data;
      return publicLifecycleGateOpen() &&
        validPublicBuildingShape(after, setId) && validOwnerProjectionAfter(after, setId) &&
        after.publishedAt == null && after.updatedAt == request.time &&
        after.buildVideoCount == 0 && after.buildQuestionCount == 0 &&
        after.buildImageCount == 0 && !('buildMutation' in after);
    }

    function validBuildingReplace(setId) {
      let before = resource.data;
      let after = request.resource.data;
      return publicLifecycleGateOpen() &&
        before.status in ['published', 'withdrawn', 'cancelled'] &&
        before.moderationStatus == 'clear' &&
        validPublicBuildingShape(after, setId) && validOwnerProjectionAfter(after, setId) &&
        after.publishedAt == before.publishedAt &&
        after.updatedAt == request.time && after.updatedAt >= before.updatedAt &&
        after.buildVideoCount == 0 && after.buildQuestionCount == 0 &&
        after.buildImageCount == 0 && !('buildMutation' in after);
    }

    function validBuildingProcessedUpdate(setId) {
      let before = resource.data;
      let after = request.resource.data;
      let mutation = after.get('buildMutation', {});
      let videoPath = publicationVideoPath(setId, mutation.key);
      let questionPath = publicationQuestionPath(setId, mutation.key);
      let imagePath = publicationImagePath(setId, mutation.key);
      return publicLifecycleGateOpen() &&
        before.status == 'building' && before.moderationStatus == 'clear' &&
        validPublicBuildingStepShape(after, setId) &&
        validOwnerPublicationLifecycleAfter(after, setId) &&
        ((validBuildMutation(mutation, 'videos', mutation.key) &&
            after.diff(before).affectedKeys().hasOnly(['buildVideoCount', 'buildMutation']) &&
            after.buildVideoCount == before.buildVideoCount + 1 &&
            validBuildTargetRebind(videoPath, after.buildToken) &&
            getAfter(videoPath).data.revision == after.revision &&
            getAfter(videoPath).data.buildToken == after.buildToken) ||
          (validBuildMutation(mutation, 'questions', mutation.key) &&
            after.diff(before).affectedKeys().hasOnly(['buildQuestionCount', 'buildMutation']) &&
            after.buildQuestionCount == before.buildQuestionCount + 1 &&
            validBuildTargetRebind(questionPath, after.buildToken) &&
            getAfter(questionPath).data.revision == after.revision &&
            getAfter(questionPath).data.buildToken == after.buildToken) ||
          (validBuildMutation(mutation, 'images', mutation.key) &&
            validPublicImageKey(mutation.key) &&
            after.diff(before).affectedKeys().hasOnly(['buildImageCount', 'buildMutation']) &&
            after.buildImageCount == before.buildImageCount + 1 &&
            validBuildTargetRebind(imagePath, after.buildToken) &&
            getAfter(imagePath).data.revision == after.revision &&
            getAfter(imagePath).data.buildToken == after.buildToken));
    }

    function validPublicationFinalization(setId) {
      let before = resource.data;
      let after = request.resource.data;
      return publicLifecycleGateOpen() &&
        before.status == 'building' && before.moderationStatus == 'clear' &&
        before.buildToken is string && before.buildImageCount is int &&
        validPublicParentShape(after, setId) && validOwnerProjectionAfter(after, setId) &&
        publicContentUnchanged(before, after) &&
        after.status == 'published' && after.moderationStatus == 'clear' &&
        !('buildToken' in after) && !('buildVideoCount' in after) &&
        !('buildQuestionCount' in after) && !('buildImageCount' in after) &&
        !('buildMutation' in after) &&
        before.buildVideoCount == after.videoCount &&
        before.buildQuestionCount == after.questionCount &&
        before.buildImageCount == after.imageCount &&
        ((before.publishedAt == null && after.publishedAt == request.time) ||
          (before.publishedAt is timestamp && after.publishedAt == before.publishedAt)) &&
        after.updatedAt == request.time && after.updatedAt >= before.updatedAt &&
        after.updatedAt >= after.publishedAt;
    }

    function validOwnerWithdrawal(setId) {
      let source = get(publicationSourcePath(setId)).data;
      let before = resource.data;
      let after = request.resource.data;
      return requesterOwnsPublicationSource(setId) &&
        before.publicationId == setId && before.sourceSetId == setId &&
        before.revision is string && before.updatedAt is timestamp &&
        before.status == 'published' && before.moderationStatus == 'clear' &&
        after.status == 'withdrawn' && after.moderationStatus == 'clear' &&
        sourceRevision(source) == before.revision &&
        after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        after.updatedAt == request.time && after.updatedAt >= before.updatedAt;
    }

    function validLifecycleWithdrawal(setId) {
      let sourcePath = publicationSourcePath(setId);
      let source = get(sourcePath).data;
      let allowancePath = /databases/$(database)/documents/teacher_allowances/$(source.ownerUid);
      let allowance = get(allowancePath).data;
      let before = resource.data;
      let after = request.resource.data;
      let exactOwner = verifiedEmail() && exists(allowancePath) &&
        source.ownerUid == request.auth.uid && source.ownerEmail == request.auth.token.email &&
        [allowance.uid, allowance.emailCanonical, allowance.status, allowance.enabled] ==
          [source.ownerUid, source.ownerEmail, 'active', true] &&
        allowance.role in ['teacher', 'admin'];
      let lockPath = publicationLifecycleLockPath(source.ownerUid);
      let pairedSourceLifecycle = existsAfter(sourcePath) &&
        getAfter(sourcePath).data.get('lifecycleState', '') in ['trashed', 'purging'];
      return exists(sourcePath) && (exactOwner || isAdmin()) &&
        (pairedSourceLifecycle || exists(lockPath)) &&
        sourceRevision(source) == before.revision &&
        before.publicationId == setId && before.sourceSetId == setId &&
        before.revision is string && before.updatedAt is timestamp &&
        before.status == 'published' && before.moderationStatus == 'clear' &&
        after.status == 'withdrawn' && after.moderationStatus == 'clear' &&
        after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        after.updatedAt == request.time && after.updatedAt >= before.updatedAt;
    }

    function validLifecycleBuildingCancellation(setId) {
      let sourcePath = publicationSourcePath(setId);
      let source = get(sourcePath).data;
      let before = resource.data;
      let after = request.resource.data;
      let pairedSourceLifecycle = existsAfter(sourcePath) &&
        getAfter(sourcePath).data.get('lifecycleState', '') in ['trashed', 'purging'];
      return exists(sourcePath) &&
        (request.auth.uid == source.ownerUid || isAdmin()) &&
        (pairedSourceLifecycle || exists(publicationLifecycleLockPath(source.ownerUid))) &&
        before.publicationId == setId && before.sourceSetId == setId &&
        before.revision is string && before.updatedAt is timestamp &&
        before.buildToken is string && before.buildToken.size() >= 1 &&
        before.buildVideoCount is int && before.buildQuestionCount is int &&
        before.buildImageCount is int &&
        before.status == 'building' && before.moderationStatus == 'clear' &&
        after.status == 'cancelled' && after.moderationStatus == 'clear' &&
        after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        after.updatedAt == request.time && after.updatedAt >= before.updatedAt;
    }

    function validLifecyclePublicationBarrier(setId) {
      let path = publicationPath(setId);
      let before = exists(path) ? get(path).data : {};
      let after = existsAfter(path) ? getAfter(path).data : {};
      return !exists(path)
        ? !existsAfter(path)
        : existsAfter(path) &&
          (before.get('status', '') == 'published'
            ? before.get('moderationStatus', '') == 'clear' &&
              after.get('status', '') == 'withdrawn' &&
              after.get('moderationStatus', '') == 'clear' &&
              after.get('revision', '') == before.get('revision', '') &&
              after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt']) &&
              after.get('updatedAt', request.time) == request.time
            : before.get('status', '') == 'building'
              ? after.get('status', '') == 'cancelled' &&
                after.get('moderationStatus', '') == 'clear' &&
                after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                after.get('updatedAt', request.time) == request.time
              : after == before);
    }

    function validModeratedAudit(data, setId, revision) {
      let keys = [
        'publicationId', 'revision', 'status', 'moderatedByUid',
        'moderationReason', 'moderatedAt'
      ];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
        data.publicationId == setId && data.revision == revision &&
        data.status == 'moderated' && data.moderatedByUid == request.auth.uid &&
        data.moderationReason is string &&
        data.moderationReason == data.moderationReason.trim() &&
        data.moderationReason.size() >= 1 && data.moderationReason.size() <= 200 &&
        data.moderatedAt == request.time;
    }

    function validRestoredAudit(before, after, setId, revision) {
      let keys = [
        'publicationId', 'revision', 'status', 'moderatedByUid',
        'moderationReason', 'moderatedAt', 'restoredByUid', 'restoredAt'
      ];
      return validModeratedStoredAudit(before, setId, revision) &&
        after.keys().hasAll(keys) && after.keys().hasOnly(keys) &&
        after.publicationId == before.publicationId && after.revision == before.revision &&
        after.status == 'restored' &&
        after.moderatedByUid == before.moderatedByUid &&
        after.moderationReason == before.moderationReason &&
        after.moderatedAt == before.moderatedAt &&
        after.restoredByUid == request.auth.uid && after.restoredAt == request.time &&
        after.restoredAt >= before.moderatedAt;
    }

    function validModeratedStoredAudit(data, setId, revision) {
      let keys = [
        'publicationId', 'revision', 'status', 'moderatedByUid',
        'moderationReason', 'moderatedAt'
      ];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
        data.publicationId == setId && data.revision == revision &&
        data.status == 'moderated' && data.moderatedByUid is string &&
        data.moderatedByUid.size() >= 1 && data.moderationReason is string &&
        data.moderationReason == data.moderationReason.trim() &&
        data.moderationReason.size() >= 1 && data.moderationReason.size() <= 200 &&
        data.moderatedAt is timestamp;
    }

    function validModerationParent(setId) {
      let parentPath = publicationPath(setId);
      let auditPath = publicationAuditPath(setId);
      let before = get(parentPath).data;
      let after = getAfter(parentPath).data;
      let auditBefore = exists(auditPath) ? get(auditPath).data : {};
      let audit = getAfter(auditPath).data;
      return publicLifecycleGateOpen() &&
        isAdmin() && exists(parentPath) && existsAfter(parentPath) &&
        existsAfter(auditPath) &&
        (!exists(auditPath)
          ? true
          : auditBefore.status == 'restored' &&
            audit.diff(auditBefore).affectedKeys().hasAll(['status', 'moderatedAt']) &&
            audit.diff(auditBefore).affectedKeys().hasOnly([
              'status', 'moderatedByUid', 'moderationReason', 'moderatedAt',
              'restoredByUid', 'restoredAt'
            ])) &&
        validPublicParentShape(after, setId) &&
        before.status == 'published' &&
        before.moderationStatus == 'clear' && after.status == 'moderated' &&
        after.moderationStatus == 'moderated' && after.revision == before.revision &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'moderationStatus', 'updatedAt'
        ]) && after.updatedAt == request.time && after.updatedAt >= before.updatedAt &&
        audit.publicationId == setId && audit.revision == before.revision &&
        audit.status == 'moderated' && audit.moderatedByUid == request.auth.uid &&
        audit.moderatedAt == request.time;
    }

    function validModerationAuditPair(setId) {
      let parentPath = publicationPath(setId);
      let before = get(parentPath).data;
      let after = getAfter(parentPath).data;
      return isAdmin() && exists(parentPath) && existsAfter(parentPath) &&
        before.status == 'published' && before.moderationStatus == 'clear' &&
        after.status == 'moderated' && after.moderationStatus == 'moderated' &&
        after.revision == before.revision &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'moderationStatus', 'updatedAt'
        ]) && after.updatedAt == request.time &&
        validModeratedAudit(request.resource.data, setId, before.revision);
    }

    function validRestoreParent(setId) {
      let parentPath = publicationPath(setId);
      let auditPath = publicationAuditPath(setId);
      let before = get(parentPath).data;
      let after = getAfter(parentPath).data;
      let auditBefore = get(auditPath).data;
      let auditAfter = getAfter(auditPath).data;
      return publicLifecycleGateOpen() &&
        isAdmin() && exists(parentPath) && existsAfter(parentPath) &&
        exists(auditPath) && existsAfter(auditPath) &&
        after.keys().hasAll(publicParentKeys()) && after.keys().hasOnly(publicParentKeys()) &&
        before.status == 'moderated' && before.moderationStatus == 'moderated' &&
        after.status == 'published' && after.moderationStatus == 'clear' &&
        after.revision == before.revision && publicMatchesActiveSourceAfter(after, setId) &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'moderationStatus', 'updatedAt'
        ]) && after.updatedAt == request.time && after.updatedAt >= before.updatedAt &&
        auditBefore.status == 'moderated' && auditBefore.revision == before.revision &&
        auditAfter.status == 'restored' && auditAfter.revision == before.revision &&
        auditAfter.restoredByUid == request.auth.uid &&
        auditAfter.restoredAt == request.time &&
        auditAfter.diff(auditBefore).affectedKeys().hasOnly([
          'status', 'restoredByUid', 'restoredAt'
        ]);
    }

    function validPublicationLifecycleLockData(uid, data, allowance) {
      return data.keys().hasAll([
          'ownerUid', 'ownerEmailCanonical', 'allowanceRevision', 'allowanceRole',
          'allowanceStatus', 'allowanceEnabled', 'reason', 'operationId',
          'initiatedByUid', 'initiatedByRole', 'createdAt'
        ]) && data.keys().hasOnly([
          'ownerUid', 'ownerEmailCanonical', 'allowanceRevision', 'allowanceRole',
          'allowanceStatus', 'allowanceEnabled', 'reason', 'operationId',
          'initiatedByUid', 'initiatedByRole', 'createdAt'
        ]) && data.ownerUid == uid && data.ownerEmailCanonical == allowance.emailCanonical &&
        data.allowanceRevision == allowance.get('revision', 0) &&
        data.allowanceRole == allowance.role && data.allowanceStatus == allowance.status &&
        data.allowanceEnabled == allowance.enabled &&
        data.reason in ['teacher-suspension', 'teacher-deletion-pending'] &&
        data.operationId is string && data.operationId.size() >= 1 &&
        data.operationId.size() <= 200 && data.initiatedByUid == request.auth.uid &&
        data.initiatedByRole in ['teacher', 'admin'] && data.createdAt is timestamp;
    }

    function validPublicationLifecycleLockCreate(uid) {
      let allowancePath = /databases/$(database)/documents/teacher_allowances/$(uid);
      let allowance = get(allowancePath).data;
      let data = request.resource.data;
      let ownDeletion = verifiedEmail() && uid == request.auth.uid &&
        allowance.emailCanonical == request.auth.token.email && allowance.role == 'teacher' &&
        data.reason == 'teacher-deletion-pending' && data.initiatedByRole == 'teacher';
      let adminSuspension = isAdmin() && data.reason == 'teacher-suspension' &&
        data.initiatedByRole == 'admin';
      let gatePath = /databases/$(database)/documents/publication_lifecycle_gates/current;
      return exists(allowancePath) && allowance.uid == uid &&
        allowance.status in ['active', 'suspended'] &&
        validPublicationLifecycleLockData(uid, data, allowance) &&
        data.createdAt == request.time && existsAfter(gatePath) &&
        getAfter(gatePath).data == data && (ownDeletion || adminSuspension);
    }

    function validConsumedPublicationLifecycleLock(uid, allowance, reason) {
      let lockPath = publicationLifecycleLockPath(uid);
      let lock = get(lockPath).data;
      return exists(lockPath) && !existsAfter(lockPath) &&
        validPublicationLifecycleLockData(uid, lock, allowance) &&
        lock.reason == reason;
    }

    function validPublicationLifecycleLockDelete(uid) {
      let allowancePath = /databases/$(database)/documents/teacher_allowances/$(uid);
      let before = get(allowancePath).data;
      let after = getAfter(allowancePath).data;
      let lock = resource.data;
      let exactInitiator = lock.initiatedByUid == request.auth.uid &&
        ((uid == request.auth.uid && verifiedEmail() &&
            request.auth.token.email == before.emailCanonical) || isAdmin());
      let unchanged = existsAfter(allowancePath) && after == before;
      let consumed = existsAfter(allowancePath) && after.uid == before.uid &&
        after.emailCanonical == before.emailCanonical &&
        after.get('revision', 0) == before.get('revision', 0) + 1 &&
        after.status != 'active' && after.enabled == false;
      let gatePath = /databases/$(database)/documents/publication_lifecycle_gates/current;
      return exists(allowancePath) && exactInitiator && exists(gatePath) &&
        get(gatePath).data == lock && !existsAfter(gatePath) &&
        validPublicationLifecycleLockData(uid, lock, before) &&
        (unchanged || consumed);
    }

    function validPublicationLifecycleGateCreate() {
      let data = request.resource.data;
      let uid = data.get('ownerUid', '');
      let allowancePath = /databases/$(database)/documents/teacher_allowances/$(uid);
      let lockPath = /databases/$(database)/documents/publication_lifecycle_locks/$(uid);
      return uid is string && uid.size() >= 1 && exists(allowancePath) &&
        existsAfter(lockPath) && getAfter(lockPath).data == data &&
        validPublicationLifecycleLockData(uid, data, get(allowancePath).data) &&
        data.createdAt == request.time;
    }

    function validPublicationLifecycleGateDelete() {
      let data = resource.data;
      let uid = data.get('ownerUid', '');
      let lockPath = /databases/$(database)/documents/publication_lifecycle_locks/$(uid);
      return uid is string && uid.size() >= 1 && exists(lockPath) &&
        get(lockPath).data == data && !existsAfter(lockPath) &&
        data.initiatedByUid == request.auth.uid;
    }

    function validRestoreAuditPair(setId) {
      let parentPath = publicationPath(setId);
      let before = get(parentPath).data;
      let after = getAfter(parentPath).data;
      return publicLifecycleGateOpen() &&
        isAdmin() && exists(parentPath) && existsAfter(parentPath) &&
        before.status == 'moderated' && before.moderationStatus == 'moderated' &&
        after.status == 'published' && after.moderationStatus == 'clear' &&
        after.revision == before.revision &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'moderationStatus', 'updatedAt'
        ]) && after.updatedAt == request.time &&
        validRestoredAudit(resource.data, request.resource.data, setId, before.revision);
    }

    function validPublicImageData(data, revision, buildToken) {
      let keys = ['data', 'revision', 'schemaVersion', 'buildToken'];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
        data.data is string && data.data.size() >= 1 && data.data.size() <= 380100 &&
        (data.data.matches('^data:image/.*$') || data.data.matches('^https://.*$')) &&
        data.schemaVersion == 1 &&
        data.revision == revision && data.buildToken == buildToken &&
        data.buildToken is string && data.buildToken.size() >= 1 &&
        data.buildToken.size() <= 200;
    }

    function validPublicImageKey(key) {
      return key.matches('^v(0|[1-9][0-9]*)q(0|[1-9][0-9]*)(e?)$');
    }

    function validPublicBindParent(setId, key, collectionName, countField) {
      let parentBefore = get(publicationPath(setId)).data;
      let parentAfter = getAfter(publicationPath(setId)).data;
      return publicLifecycleGateOpen() &&
        parentBefore.status == 'building' && parentBefore.moderationStatus == 'clear' &&
        parentAfter.status == 'building' && parentAfter.moderationStatus == 'clear' &&
        parentAfter.revision == parentBefore.revision &&
        parentAfter.buildToken == parentBefore.buildToken &&
        validBuildMutation(parentAfter.get('buildMutation', {}), collectionName, key) &&
        parentAfter.diff(parentBefore).affectedKeys().hasOnly([countField, 'buildMutation']) &&
        parentAfter[countField] == parentBefore[countField] + 1;
    }

    function validPublicVideoBind(setId, key) {
      let parentAfter = getAfter(publicationPath(setId)).data;
      return validPublicBindParent(setId, key, 'videos', 'buildVideoCount') &&
        (!exists(publicationVideoPath(setId, key)) ||
          resource.data.get('buildToken', '') != parentAfter.buildToken) &&
        validPublicVideoPart(request.resource.data, key,
          parentAfter.revision, parentAfter.buildToken);
    }

    function validPublicQuestionBind(setId, key) {
      let parentAfter = getAfter(publicationPath(setId)).data;
      return validPublicBindParent(setId, key, 'questions', 'buildQuestionCount') &&
        (!exists(publicationQuestionPath(setId, key)) ||
          resource.data.get('buildToken', '') != parentAfter.buildToken) &&
        validPublicQuestionPart(request.resource.data, key,
          parentAfter.revision, parentAfter.buildToken);
    }

    function validPublicImageBind(setId, key) {
      let parentAfter = getAfter(publicationPath(setId)).data;
      let privatePath = privateImagePath(setId, key);
      return validPublicImageKey(key) &&
        validPublicBindParent(setId, key, 'images', 'buildImageCount') &&
        (!exists(publicationImagePath(setId, key)) ||
          resource.data.get('buildToken', '') != parentAfter.buildToken) &&
        validPublicImageData(request.resource.data, parentAfter.revision, parentAfter.buildToken) &&
        existsAfter(privatePath) && request.resource.data.data == getAfter(privatePath).data.data;
    }

    function visiblePublicImage(setId, data) {
      let parent = get(publicationPath(setId)).data;
      return isApprovedTeacher() && parent.status == 'published' &&
        parent.revision is string && visiblePublicationSourceIsActive(setId) &&
        validPublicImageData(data, parent.revision, data.buildToken);
    }

    function visiblePublicVideo(setId, key, data) {
      let parent = get(publicationPath(setId)).data;
      return isApprovedTeacher() && parent.status == 'published' &&
        parent.revision is string && visiblePublicationSourceIsActive(setId) &&
        validPublicVideoPart(data, key, parent.revision, data.buildToken);
    }

    function visiblePublicQuestion(setId, key, data) {
      let parent = get(publicationPath(setId)).data;
      return isApprovedTeacher() && parent.status == 'published' &&
        parent.revision is string && visiblePublicationSourceIsActive(setId) &&
        validPublicQuestionPart(data, key, parent.revision, data.buildToken);
    }

    function ownerMayReadHiddenPublication(setId) {
      let path = publicationPath(setId);
      return requesterOwnsPublicationSource(setId) &&
        (!exists(path) || get(path).data.get('status', '') in ['building', 'cancelled', 'withdrawn']);
    }

    function lifecycleManagerMayReadHiddenPublication(setId) {
      let sourcePath = publicationSourcePath(setId);
      return exists(sourcePath) && isApprovedTeacher() &&
        (get(sourcePath).data.ownerUid == request.auth.uid || isAdmin());
    }

    function ownerMayReadPublicationStatus(setId) {
      let path = publicationPath(setId);
      return requesterOwnsPublicationSource(setId) &&
        (!exists(path) ||
          get(path).data.get('status', '') in ['building', 'cancelled', 'withdrawn', 'moderated']);
    }

    function validPublicationGet(setId) {
      let path = publicationPath(setId);
      return !exists(path)
        ? lifecycleOwnerMayAuditPublication(setId) || isAdmin()
        : isAdmin()
          ? (resource.data.get('status', '') in ['building', 'cancelled']
              ? validPublicBuildingShape(resource.data, setId)
              : validPublicParentShape(resource.data, setId))
          : resource.data.get('status', '') == 'published'
            ? validPublicParentShape(resource.data, setId) &&
              ownerAuthorMatchesAllowance(resource.data, setId) &&
              ((isApprovedTeacher() && visiblePublicationSourceIsActive(setId)) ||
                lifecycleOwnerMayAuditPublication(setId))
            : (ownerMayReadPublicationStatus(setId) ||
                lifecycleManagerMayReadHiddenPublication(setId)) &&
              (resource.data.get('status', '') in ['building', 'cancelled']
                ? validPublicBuildingShape(resource.data, setId)
                : validPublicParentShape(resource.data, setId));
    }

    function validPublicImageGet(setId, key, data) {
      let childPath = publicationImagePath(setId, key);
      let parent = get(publicationPath(setId)).data;
      return !exists(childPath)
        ? (ownerMayReadHiddenPublication(setId) ||
            lifecycleManagerMayReadHiddenPublication(setId))
        : parent.get('status', '') == 'published'
        ? visiblePublicImage(setId, data)
        : (ownerMayReadHiddenPublication(setId) ||
            lifecycleManagerMayReadHiddenPublication(setId)) &&
          validPublicImageData(data, data.revision, data.buildToken);
    }

    function validPublicImageList(setId, key, data) {
      let path = publicationPath(setId);
      let parent = get(path).data;
      return !exists(path)
        ? canPurgeSet(setId)
        : parent.get('status', '') == 'published'
          ? isApprovedTeacher() && parent.revision is string &&
            visiblePublicationSourceIsActive(setId) &&
            data.revision == parent.revision && data.schemaVersion == 1
          : ownerMayReadHiddenPublication(setId) ||
            lifecycleManagerMayReadHiddenPublication(setId);
    }

    function validPublicImagePurgeDelete(setId, key) {
      let parentPath = publicationPath(setId);
      return canPurgeSet(setId) && validPublicImageKey(key) && exists(parentPath) &&
        get(parentPath).data.get('status', '') != 'published' &&
        validPublicImageData(resource.data, resource.data.revision, resource.data.buildToken);
    }

    function validPublicVideoGet(setId, key, data) {
      let childPath = publicationVideoPath(setId, key);
      return !exists(childPath)
        ? ownerMayReadHiddenPublication(setId)
        : get(publicationPath(setId)).data.get('status', '') == 'published'
        ? visiblePublicVideo(setId, key, data)
        : ownerMayReadHiddenPublication(setId) &&
          validPublicVideoPart(data, key, data.revision, data.buildToken);
    }

    function validPublicVideoList(setId, key, data) {
      let path = publicationPath(setId);
      let parent = get(path).data;
      return exists(path) &&
        (parent.get('status', '') == 'published'
          ? isApprovedTeacher() && parent.revision is string &&
            visiblePublicationSourceIsActive(setId) &&
            data.revision == parent.revision && data.schemaVersion == 1
          : ownerMayReadHiddenPublication(setId) &&
            data.revision == parent.revision && data.schemaVersion == 1);
    }

    function validPublicQuestionGet(setId, key, data) {
      let childPath = publicationQuestionPath(setId, key);
      return !exists(childPath)
        ? ownerMayReadHiddenPublication(setId)
        : get(publicationPath(setId)).data.get('status', '') == 'published'
        ? visiblePublicQuestion(setId, key, data)
        : ownerMayReadHiddenPublication(setId) &&
          validPublicQuestionPart(data, key, data.revision, data.buildToken);
    }

    function validPublicQuestionList(setId, key, data) {
      let path = publicationPath(setId);
      let parent = get(path).data;
      return exists(path) &&
        (parent.get('status', '') == 'published'
          ? isApprovedTeacher() && parent.revision is string &&
            visiblePublicationSourceIsActive(setId) &&
            data.revision == parent.revision && data.schemaVersion == 1
          : ownerMayReadHiddenPublication(setId) &&
            data.revision == parent.revision && data.schemaVersion == 1);
    }

    function publicCopyBaseKeys() {
      return [
        'title', 'description', 'videos', 'settings', 'publicationId', 'sourceTitle',
        'sourceAuthorDisplayName', 'visibility', 'collaboratorCount', 'imageCount',
        'sourcePublicationRevision', 'ownerUid', 'ownerEmail', 'lifecycleState',
        'copyStatus', 'createdAt', 'updatedAt', 'contentRevision'
      ];
    }

    function activePublicCopyKeys() {
      return [
        'title', 'description', 'videos', 'settings', 'publicationId', 'sourceTitle',
        'sourceAuthorDisplayName', 'visibility', 'collaboratorCount', 'imageCount',
        'sourcePublicationRevision', 'ownerUid', 'ownerEmail', 'lifecycleState',
        'createdAt', 'updatedAt', 'contentRevision'
      ];
    }

    function copyingPublicCopyKeys() {
      return [
        'title', 'description', 'videos', 'settings', 'publicationId', 'sourceTitle',
        'sourceAuthorDisplayName', 'visibility', 'collaboratorCount', 'imageCount',
        'sourcePublicationRevision', 'ownerUid', 'ownerEmail', 'lifecycleState',
        'copyStatus', 'createdAt', 'updatedAt', 'contentRevision', 'imageMutation'
      ];
    }

    function publicCopyTitle(publicTitle) {
      let title = publicTitle + ' (사본)';
      return title.size() <= 200 ? title : title[0:200];
    }

    function validRequestingTeacherAfter() {
      let path = teacherAllowancePath();
      let allowance = getAfter(path).data;
      return verifiedEmail() && existsAfter(path) &&
        [allowance.uid, allowance.emailCanonical, allowance.status, allowance.enabled] ==
          [request.auth.uid, request.auth.token.email, 'active', true] &&
        allowance.role in ['teacher', 'admin'];
    }

    function validPublishedCopySource(publicationId) {
      let path = publicationPath(publicationId);
      let publication = getAfter(path).data;
      return publicLifecycleGateOpen() && existsAfter(path) &&
        publication.keys().hasAll(publicParentKeys()) &&
        publication.keys().hasOnly(publicParentKeys()) &&
        publication.publicationId == publicationId && publication.sourceSetId == publicationId &&
        publication.status == 'published' && publication.moderationStatus == 'clear' &&
        publication.revision is string && publication.imageCount is int &&
        publication.imageCount >= 0 && publication.title is string &&
        publication.description is string && publication.authorDisplayName is string &&
        publicMatchesActiveSourceAfter(publication, publicationId);
    }

    function validPublishedCopySourceStillActive(data) {
      let path = publicationPath(data.publicationId);
      let publication = getAfter(path).data;
      return publicLifecycleGateOpen() && existsAfter(path) &&
        publication.publicationId == data.publicationId &&
        publication.sourceSetId == data.publicationId &&
        publication.status == 'published' && publication.moderationStatus == 'clear' &&
        publication.revision == data.sourcePublicationRevision &&
        publicMatchesActiveSourceAfter(publication, data.publicationId);
    }

    function validPublicCopyProvenance(data) {
      let publication = getAfter(publicationPath(data.publicationId)).data;
      return validPublishedCopySource(data.publicationId) &&
        data.sourcePublicationRevision == publication.revision &&
        data.title == publicCopyTitle(publication.title) &&
        data.description == publication.description && data.videos is list &&
        data.settings is map && data.sourceTitle == publication.title &&
        data.sourceAuthorDisplayName == publication.authorDisplayName &&
        data.visibility == 'private' && data.collaboratorCount == 0;
    }

    function validPrivateCopyStart(setId) {
      let after = request.resource.data;
      return validRequestingTeacherAfter() && after.keys().hasAll(publicCopyBaseKeys()) &&
        after.keys().hasOnly(publicCopyBaseKeys()) && validCanonicalPublicationId(setId) &&
        validCanonicalPublicationId(after.publicationId) && setId != after.publicationId &&
        after.ownerUid == request.auth.uid && after.ownerEmail == request.auth.token.email &&
        after.lifecycleState == 'copying' && after.copyStatus == 'building' &&
        after.imageCount == 0 && !('imageMutation' in after) &&
        after.createdAt == request.time && after.updatedAt == request.time &&
        after.contentRevision == request.time && validPublicCopyProvenance(after);
    }

    function validCopyingDestinationShape(data) {
      let required = publicCopyBaseKeys();
      return data.keys().hasAll(required) &&
        data.keys().hasOnly(copyingPublicCopyKeys()) &&
        data.ownerUid == request.auth.uid && data.ownerEmail == request.auth.token.email &&
        data.lifecycleState == 'copying' && data.copyStatus == 'building' &&
        data.imageCount is int && data.imageCount >= 0 && data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.contentRevision is timestamp;
    }

    function validCopyImageIncrement(setId) {
      let parentPath = publicationSourcePath(setId);
      let before = get(parentPath).data;
      let after = getAfter(parentPath).data;
      let mutation = after.get('imageMutation', {});
      let childPath = privateImagePath(setId, mutation.key);
      let publication = getAfter(publicationPath(after.publicationId)).data;
      return isApprovedTeacher() && before.lifecycleState == 'copying' &&
        before.copyStatus == 'building' && before.ownerUid == request.auth.uid &&
        before.ownerEmail == request.auth.token.email &&
        validCopyingDestinationShape(after) && validPublishedCopySourceStillActive(after) &&
        after.diff(before).affectedKeys().hasOnly([
          'imageCount', 'imageMutation', 'updatedAt', 'contentRevision'
        ]) && mutation.keys().hasAll(['key', 'action']) &&
        mutation.keys().hasOnly(['key', 'action']) && validPublicImageKey(mutation.key) &&
        mutation.action == 'add' && !exists(childPath) && existsAfter(childPath) &&
        after.imageCount == before.imageCount + 1 &&
        after.imageCount <= publication.imageCount &&
        after.updatedAt == request.time && after.contentRevision == request.time;
    }

    function validCopyImageCreate(setId, key) {
      let parentPath = publicationSourcePath(setId);
      let before = get(parentPath).data;
      let after = getAfter(parentPath).data;
      let mutation = after.get('imageMutation', {});
      let publicImagePath = publicationImagePath(after.publicationId, key);
      let publicImage = getAfter(publicImagePath).data;
      let publication = getAfter(publicationPath(after.publicationId)).data;
      return exists(parentPath) && existsAfter(parentPath) &&
        before.lifecycleState == 'copying' && after.lifecycleState == 'copying' &&
        before.ownerUid == request.auth.uid && after.ownerUid == request.auth.uid &&
        mutation.keys().hasAll(['key', 'action']) &&
        mutation.keys().hasOnly(['key', 'action']) && mutation.key == key &&
        mutation.action == 'add' && validPublicImageKey(key) &&
        after.diff(before).affectedKeys().hasOnly([
          'imageCount', 'imageMutation', 'updatedAt', 'contentRevision'
        ]) && after.imageCount == before.imageCount + 1 &&
        request.resource.data.keys().hasAll(['data']) &&
        request.resource.data.keys().hasOnly(['data']) &&
        request.resource.data.data is string && existsAfter(publicImagePath) &&
        publication.status == 'published' && publication.moderationStatus == 'clear' &&
        publicImage.revision == publication.revision &&
        publicImage.data == request.resource.data.data;
    }

    function validPrivateCopyFinalize(setId) {
      let before = resource.data;
      let after = request.resource.data;
      let publication = getAfter(publicationPath(before.publicationId)).data;
      return isApprovedTeacher() && before.lifecycleState == 'copying' &&
        before.copyStatus == 'building' && before.ownerUid == request.auth.uid &&
        before.ownerEmail == request.auth.token.email &&
        after.keys().hasAll(activePublicCopyKeys()) &&
        after.keys().hasOnly(activePublicCopyKeys()) &&
        after.ownerUid == request.auth.uid && after.ownerEmail == request.auth.token.email &&
        after.lifecycleState == 'active' && !('copyStatus' in after) &&
        !('imageMutation' in after) && validPublishedCopySourceStillActive(after) &&
        after.diff(before).affectedKeys().hasOnly([
          'lifecycleState', 'copyStatus', 'imageMutation', 'updatedAt', 'contentRevision'
        ]) && after.imageCount == publication.imageCount &&
        after.updatedAt == request.time && after.contentRevision == request.time;
    }

    function canReadPrivateSet(setId) {
      let path = publicationSourcePath(setId);
      let source = get(path).data;
      return !exists(path)
        ? false
        : !isApprovedTeacher()
          ? false
          : source.ownerUid == request.auth.uid
            ? true
            : isAdmin()
              ? true
              : source.get('lifecycleState', 'active') == 'active' &&
                exists(collaboratorPath(setId)) &&
                validStoredCollaboratorData(
                  get(collaboratorPath(setId)).data,
                  request.auth.token.email
                );
    }

    function validEditablePrivateSetUpdate(setId) {
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'ownerUid', 'ownerEmail', 'trashedAt', 'purgeStartedAt', 'lifecycleState',
          'imageCount', 'imageMutation', 'publicationId', 'sourcePublicationRevision',
          'sourceTitle', 'sourceAuthorDisplayName', 'visibility', 'copyStatus'
        ])) && canEditSet(setId) && activeSet(setId) &&
        request.resource.data.lifecycleState in ['active', 'trashed', 'purging'] &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.ownerEmail == resource.data.ownerEmail &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['archived']) ||
          ownsSet(setId)) && validCollaboratorCount(setId);
    }

    function validPrivateSetUpdate(setId) {
      return resource.data.get('lifecycleState', '') == 'copying'
        ? (request.resource.data.get('lifecycleState', '') == 'copying'
          ? validCopyImageIncrement(setId)
          : validPrivateCopyFinalize(setId))
        : resource.data.get('lifecycleState', '') == 'purging' ||
          request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'trashedAt', 'purgeStartedAt', 'lifecycleState', 'imageCount',
            'imageMutation'
          ])
          ? validSetLifecycleTransition(setId)
          : validEditablePrivateSetUpdate(setId);
    }

    function validPrivateImageCreate(setId, key) {
      let parent = getAfter(publicationSourcePath(setId)).data;
      return parent.get('lifecycleState', '') == 'copying'
        ? validCopyImageCreate(setId, key)
        : counterMigrationUnlocked() && validActiveImageCreate(setId, key);
    }

    function validPublicParentUpdate(setId) {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'building'
        ? (after.status == 'building'
          ? validBuildingProcessedUpdate(setId)
          : after.status == 'cancelled'
            ? validLifecycleBuildingCancellation(setId)
            : validPublicationFinalization(setId))
        : before.status == 'published'
          ? (after.status == 'building'
            ? validBuildingReplace(setId)
            : after.status == 'withdrawn'
              ? requesterOwnsPublicationSource(setId)
                ? validOwnerWithdrawal(setId)
                : validLifecycleWithdrawal(setId)
              : validModerationParent(setId))
          : before.status == 'withdrawn'
            ? validBuildingReplace(setId)
            : before.status == 'cancelled'
              ? validBuildingReplace(setId)
            : before.status == 'moderated'
              ? validRestoreParent(setId)
              : false;
    }

    function validPublicationAuditWrite(setId) {
      let parentBefore = get(publicationPath(setId)).data;
      return parentBefore.status == 'published'
        ? validModerationAuditPair(setId)
        : parentBefore.status == 'moderated'
          ? validRestoreAuditPair(setId)
          : false;
    }

    function ownsSession(sessionId) {
      return isApprovedTeacher() &&
        exists(/databases/$(database)/documents/sessions/$(sessionId)) &&
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.teacherUid == request.auth.uid;
    }

    function ownsSessionAfter(sessionId) {
      return isApprovedTeacher() &&
        existsAfter(/databases/$(database)/documents/sessions/$(sessionId)) &&
        getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.teacherUid == request.auth.uid;
    }

    function ownsSessionAfterForLiveMutation(sessionId) {
      let sessionPath = /databases/$(database)/documents/sessions/$(sessionId);
      return getAfter(sessionPath).data.teacherUid == request.auth.uid &&
        (isApprovedTeacher() ||
          (getAfter(sessionPath).data.status == 'ended' && isStoppedTeacherForSafeEnd()));
    }

    function sessionExists(sessionId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId));
    }

    function sessionIsJoinable(sessionId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId)) &&
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.status in ['active', 'live'] &&
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('activationLeaseUntil', null) is timestamp &&
        request.time <= get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('activationLeaseUntil', null);
    }

    function isRegisteredStudent(sessionId) {
      return anonymousStudent() &&
        sessionExists(sessionId) &&
        exists(/databases/$(database)/documents/sessions/$(sessionId)/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sessions/$(sessionId)/students/$(request.auth.uid)).data.uid == request.auth.uid;
    }

    function isJoinedStudent(sessionId) {
      return isRegisteredStudent(sessionId) && sessionIsJoinable(sessionId);
    }

    function validStudent(studentId) {
      return studentId == request.auth.uid &&
        request.resource.data.keys().hasAll(['uid', 'name']) &&
        request.resource.data.keys().hasOnly([
          'uid', 'grade', 'class', 'klass', 'number', 'num', 'name', 'joinedAt'
        ]) &&
        request.resource.data.uid == request.auth.uid;
    }

    function validChoiceList(values) {
      return values is list &&
        values.size() <= 6 &&
        (values.size() < 1 || (values[0] is string && values[0].size() <= 200)) &&
        (values.size() < 2 || (values[1] is string && values[1].size() <= 200)) &&
        (values.size() < 3 || (values[2] is string && values[2].size() <= 200)) &&
        (values.size() < 4 || (values[3] is string && values[3].size() <= 200)) &&
        (values.size() < 5 || (values[4] is string && values[4].size() <= 200)) &&
        (values.size() < 6 || (values[5] is string && values[5].size() <= 200));
    }

    function validNumberList(values) {
      return values is list &&
        values.size() > 0 &&
        values.size() <= 6 &&
        values[0] is number &&
        (values.size() < 2 || values[1] is number) &&
        (values.size() < 3 || values[2] is number) &&
        (values.size() < 4 || values[3] is number) &&
        (values.size() < 5 || values[4] is number) &&
        (values.size() < 6 || values[5] is number);
    }

    function validAnswerValue(value) {
      return value is number ||
        value is string ||
        value is bool ||
        validNumberList(value);
    }

    function validAcceptList(values) {
      return values is list &&
        values.size() <= 20 &&
        values[0] is string && values[0].size() <= 100 &&
        (values.size() < 2 || (values[1] is string && values[1].size() <= 100)) &&
        (values.size() < 3 || (values[2] is string && values[2].size() <= 100)) &&
        (values.size() < 4 || (values[3] is string && values[3].size() <= 100)) &&
        (values.size() < 5 || (values[4] is string && values[4].size() <= 100)) &&
        (values.size() < 6 || (values[5] is string && values[5].size() <= 100)) &&
        (values.size() < 7 || (values[6] is string && values[6].size() <= 100)) &&
        (values.size() < 8 || (values[7] is string && values[7].size() <= 100)) &&
        (values.size() < 9 || (values[8] is string && values[8].size() <= 100)) &&
        (values.size() < 10 || (values[9] is string && values[9].size() <= 100)) &&
        (values.size() < 11 || (values[10] is string && values[10].size() <= 100)) &&
        (values.size() < 12 || (values[11] is string && values[11].size() <= 100)) &&
        (values.size() < 13 || (values[12] is string && values[12].size() <= 100)) &&
        (values.size() < 14 || (values[13] is string && values[13].size() <= 100)) &&
        (values.size() < 15 || (values[14] is string && values[14].size() <= 100)) &&
        (values.size() < 16 || (values[15] is string && values[15].size() <= 100)) &&
        (values.size() < 17 || (values[16] is string && values[16].size() <= 100)) &&
        (values.size() < 18 || (values[17] is string && values[17].size() <= 100)) &&
        (values.size() < 19 || (values[18] is string && values[18].size() <= 100)) &&
        (values.size() < 20 || (values[19] is string && values[19].size() <= 100));
    }

    function validAnswer(answer) {
      return answer is map &&
        answer.keys().hasAll(['answer', 'submitted', 'revision']) &&
        answer.keys().hasOnly(['answer', 'submitted', 'revision', 'submittedAt']) &&
        answer.submitted is bool &&
        answer.revision is int &&
        answer.revision > 0 &&
        (!('submittedAt' in answer) || answer.submittedAt is timestamp);
    }

    function validChoiceIndex(value, choices) {
      return value is int && value >= 0 && value < choices.size();
    }

    function validMultiChoice(value, choices) {
      return value is list && value.size() > 0 && value.size() <= choices.size() &&
        (value.size() < 1 || validChoiceIndex(value[0], choices)) &&
        (value.size() < 2 || (validChoiceIndex(value[1], choices) && value[1] != value[0])) &&
        (value.size() < 3 || (validChoiceIndex(value[2], choices) && value[2] != value[0] && value[2] != value[1])) &&
        (value.size() < 4 || (validChoiceIndex(value[3], choices) && value[3] != value[0] && value[3] != value[1] && value[3] != value[2])) &&
        (value.size() < 5 || (validChoiceIndex(value[4], choices) && value[4] != value[0] && value[4] != value[1] && value[4] != value[2] && value[4] != value[3])) &&
        (value.size() < 6 || (validChoiceIndex(value[5], choices) && value[5] != value[0] && value[5] != value[1] && value[5] != value[2] && value[5] != value[3] && value[5] != value[4]));
    }

    function validAnswerForQuestion(answer, question) {
      return ((question.type in ['choice', 'mc']) && validChoiceIndex(answer, question.choices)) ||
        (question.type == 'multi' && validMultiChoice(answer, question.choices)) ||
        (question.type == 'short' && answer is string && answer.size() <= 100) ||
        (question.type == 'long' && answer is string && answer.size() <= 1000);
    }

    function validPublicQuestion(question) {
      return question is map &&
        question.keys().hasAll(['number', 'total', 'type', 'text', 'choices']) &&
        question.keys().hasOnly(['number', 'total', 'type', 'text', 'choices', 'image']) &&
        question.number is int &&
        question.number > 0 &&
        question.total is int &&
        question.total >= question.number &&
        question.type is string &&
        question.text is string && question.text.size() <= 1000 &&
        validChoiceList(question.choices) &&
        (!('image' in question) ||
          (question.image is string && question.image.size() <= 380100 &&
            question.image.matches('^(data:image/|https://).*')));
    }

    function validPublicAnswer(answer, questionType) {
      return answer is map &&
        answer.keys().hasOnly(['answer', 'answers', 'accept', 'explain', 'explainImage']) &&
        (!('explain' in answer) || (answer.explain is string && answer.explain.size() <= 1000)) &&
        (!('explainImage' in answer) ||
          (answer.explainImage is string && answer.explainImage.size() <= 380100 &&
            answer.explainImage.matches('^(data:image/|https://).*'))) &&
        ((questionType == 'short' && answer.keys().hasAll(['accept']) &&
            !('answer' in answer) && !('answers' in answer) && validAcceptList(answer.accept)) ||
          (questionType == 'long' && answer.keys().hasAll(['explain']) &&
            !('answer' in answer) && !('answers' in answer) && !('accept' in answer)) ||
          (questionType == 'multi' && answer.keys().hasAll(['answers']) &&
            !('answer' in answer) && !('accept' in answer) && validNumberList(answer.answers)) ||
          ((questionType in ['choice', 'mc']) && answer.keys().hasAll(['answer']) &&
            !('answers' in answer) && !('accept' in answer) && validAnswerValue(answer.answer)));
    }

    function validLiveData(live) {
      return live is map &&
        live.keys().hasAll(['q', 'openedAt', 'limitSec', 'revealed']) &&
        live.keys().hasOnly([
          'q', 'openedAt', 'limitSec', 'revealed', 'publicQuestion', 'publicAnswer',
          'responseClosesAt', 'submitGraceUntil', 'revealAt', 'accepting', 'liveToken'
        ]) &&
        live.q is int &&
        live.q >= -1 &&
        (live.openedAt is timestamp || live.openedAt == 0) &&
        live.limitSec is number &&
        live.limitSec >= 0 &&
        live.revealed is bool &&
        (!('accepting' in live) || live.accepting is bool) &&
        (!('liveToken' in live) || live.liveToken is string) &&
        ((!('responseClosesAt' in live) &&
            !('submitGraceUntil' in live) &&
            !('revealAt' in live)) ||
          (live.responseClosesAt is timestamp &&
            live.submitGraceUntil is timestamp &&
            live.revealAt is timestamp &&
            live.responseClosesAt <= live.submitGraceUntil &&
            live.submitGraceUntil <= live.revealAt)) &&
        ((live.q == -1 &&
            live.openedAt == 0 &&
            live.revealed == false &&
            !('liveToken' in live) &&
            !('publicQuestion' in live) &&
            !('publicAnswer' in live) &&
            !('responseClosesAt' in live) &&
            !('submitGraceUntil' in live) &&
            !('revealAt' in live)) ||
          (live.q >= 0 &&
            validPublicQuestion(live.publicQuestion) &&
            ((live.revealed == false && !('publicAnswer' in live)) ||
              (live.revealed == true &&
                validPublicAnswer(live.publicAnswer, live.publicQuestion.type)))));
    }

    function validEndedLiveData(live) {
      return live is map &&
        live.keys().hasAll(['q', 'openedAt', 'limitSec', 'revealed', 'status']) &&
        live.keys().hasOnly(['q', 'openedAt', 'limitSec', 'revealed', 'status']) &&
        live.q == -1 &&
        live.openedAt == 0 &&
        live.limitSec == 0 &&
        live.revealed == false &&
        live.status == 'ended';
    }

    function validStudentScore(studentId) {
      return request.resource.data is map &&
        request.resource.data.keys().hasAll(['uid', 'visible']) &&
        request.resource.data.keys().hasOnly(['uid', 'visible', 'score', 'graded', 'answered', 'rank', 'total']) &&
        request.resource.data.uid == studentId &&
        request.resource.data.visible is bool &&
        ((request.resource.data.visible == false &&
            !('score' in request.resource.data) &&
            !('graded' in request.resource.data) &&
            !('answered' in request.resource.data) &&
            !('rank' in request.resource.data) &&
            !('total' in request.resource.data)) ||
          (request.resource.data.visible == true &&
            request.resource.data.score is int &&
            request.resource.data.score >= 0 &&
            request.resource.data.graded is int &&
            request.resource.data.graded >= request.resource.data.score &&
            request.resource.data.answered is int &&
            request.resource.data.answered >= request.resource.data.graded &&
            request.resource.data.rank is int &&
            request.resource.data.rank > 0 &&
            request.resource.data.total is int &&
            request.resource.data.total >= request.resource.data.rank));
    }

    function validGrade(gradeId) {
      return request.resource.data is map &&
        request.resource.data.keys().hasAll(['uid', 'questionIndex', 'revision', 'ok']) &&
        request.resource.data.keys().hasOnly(['uid', 'questionIndex', 'revision', 'ok']) &&
        request.resource.data.uid is string &&
        request.resource.data.questionIndex is int &&
        request.resource.data.questionIndex >= 0 &&
        request.resource.data.revision is int &&
        request.resource.data.revision > 0 &&
        request.resource.data.ok is bool &&
        gradeId == request.resource.data.uid + '__' + string(request.resource.data.questionIndex);
    }

    function currentQuestionIsOpen(sessionId) {
      let live = get(
        /databases/$(database)/documents/sessions/$(sessionId)/meta/live
      ).data;
      return sessionIsJoinable(sessionId) &&
        exists(/databases/$(database)/documents/sessions/$(sessionId)/meta/live) &&
        live is map &&
        live.q >= 0 &&
        validPublicQuestion(live.publicQuestion) &&
        (!('accepting' in live) || live.accepting == true) &&
        ((!('submitGraceUntil' in live) && live.revealed == false) ||
          ('submitGraceUntil' in live &&
            live.submitGraceUntil is timestamp &&
            request.time <= live.submitGraceUntil));
    }

    function validLiveUpdateTransition() {
      return request.resource.data.q != resource.data.q ||
        (request.resource.data.openedAt == resource.data.openedAt &&
          request.resource.data.get('liveToken', '') == resource.data.get('liveToken', '') &&
          (resource.data.revealed == true ||
            request.resource.data.revealed == false ||
            !('revealAt' in resource.data) ||
            request.time >= resource.data.revealAt ||
            (resource.data.revealed == false &&
              request.resource.data.revealed == true &&
              resource.data.get('accepting', true) == true &&
              request.resource.data.get('accepting', true) == false)));
    }

    function validAcceptingTransition() {
      let graceFinished = !('submitGraceUntil' in resource.data) ||
        request.time >= resource.data.submitGraceUntil;
      return (request.resource.data.q != resource.data.q &&
          (resource.data.get('accepting', true) == false || graceFinished)) ||
        (request.resource.data.q == resource.data.q &&
          (resource.data.get('accepting', true) == false ||
            request.resource.data.get('accepting', true) == true || graceFinished ||
            (resource.data.revealed == false &&
              request.resource.data.revealed == true &&
              resource.data.get('accepting', true) == true &&
              request.resource.data.get('accepting', true) == false)));
    }

    function validAtomicSessionEndLive(sessionId) {
      let sessionPath = /databases/$(database)/documents/sessions/$(sessionId);
      let sessionAfter = getAfter(sessionPath).data;
      return exists(sessionPath) &&
        existsAfter(sessionPath) &&
        sessionAfter.get('status', null) == 'ended' &&
        (sessionHasCounterFields(sessionAfter)
          ? validSessionCounter(sessionAfter) &&
            sessionAfter.actualParticipants == sessionAfter.registeredStudentCount
          : legacySessionCounterCompatibilityOpen() &&
            legacySessionWithoutCounters(sessionAfter) &&
            !('actualParticipants' in sessionAfter)) &&
        validEndedLiveData(request.resource.data);
    }

    function ownsSessionForSafeDeletionEnd(sessionId) {
      return isStoppedTeacherForSafeEnd() &&
        exists(/databases/$(database)/documents/sessions/$(sessionId)) &&
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.teacherUid == request.auth.uid;
    }

    function currentQuestionKey(sessionId) {
      return string(get(
        /databases/$(database)/documents/sessions/$(sessionId)/meta/live
      ).data.q);
    }

    function validStudentResponseCreate(sessionId) {
      let live = get(/databases/$(database)/documents/sessions/$(sessionId)/meta/live).data;
      return currentQuestionIsOpen(sessionId) &&
        request.resource.data.keys().hasAll(['uid', 'answers']) &&
        request.resource.data.keys().hasOnly(['uid', 'answers']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.answers is map &&
        request.resource.data.answers.keys().hasAll([currentQuestionKey(sessionId)]) &&
        request.resource.data.answers.keys().hasOnly([currentQuestionKey(sessionId)]) &&
        validAnswer(request.resource.data.answers[currentQuestionKey(sessionId)]) &&
        validAnswerForQuestion(
          request.resource.data.answers[currentQuestionKey(sessionId)].answer,
          live.publicQuestion
        );
    }

    function validOpenStudentResponseUpdate(sessionId) {
      let questionKey = currentQuestionKey(sessionId);
      let previousAnswer = resource.data.answers.get(questionKey, { 'revision': 0 });
      let live = get(/databases/$(database)/documents/sessions/$(sessionId)/meta/live).data;
      return request.resource.data.keys().hasAll(['uid', 'answers']) &&
        request.resource.data.keys().hasOnly(['uid', 'answers']) &&
        resource.data.keys().hasAll(['uid', 'answers']) &&
        resource.data.keys().hasOnly(['uid', 'answers']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.answers is map &&
        resource.data.answers is map &&
        request.resource.data.answers.diff(resource.data.answers).affectedKeys().hasOnly([questionKey]) &&
        validAnswer(request.resource.data.answers[questionKey]) &&
        validAnswerForQuestion(request.resource.data.answers[questionKey].answer, live.publicQuestion) &&
        previousAnswer is map &&
        request.resource.data.answers[questionKey].revision > previousAnswer.get('revision', 0);
    }

    function validStudentResponseUpdate(sessionId) {
      return currentQuestionIsOpen(sessionId) &&
        validOpenStudentResponseUpdate(sessionId);
    }

    function validSessionCounter(data) {
      return data.registeredStudentCount is int && data.registeredStudentCount >= 0 &&
        data.studentCountRevision is int &&
        data.studentCountRevision == data.registeredStudentCount &&
        (data.registeredStudentCount == 0
          ? !('lastStudentUid' in data)
          : data.lastStudentUid is string && data.lastStudentUid.size() > 0 &&
            data.lastStudentUid.size() <= 128);
    }

    function sessionHasCounterFields(data) {
      return data.keys().hasAll(['registeredStudentCount', 'studentCountRevision']);
    }

    function legacySessionWithoutCounters(data) {
      return !('registeredStudentCount' in data) &&
        !('studentCountRevision' in data) && !('lastStudentUid' in data) &&
        !('actualParticipants' in data) &&
        !('classPlanId' in data) && !('classPlanRevision' in data);
    }

    function validSessionCreateCounter() {
      return request.resource.data.registeredStudentCount == 0 &&
        request.resource.data.studentCountRevision == 0 &&
        request.resource.data.status in ['active', 'allocating', 'live'] &&
        !('lastStudentUid' in request.resource.data) &&
        !('endedAt' in request.resource.data) &&
        !('actualParticipants' in request.resource.data) &&
        !('abortedAt' in request.resource.data) &&
        !('classPlanId' in request.resource.data) &&
        !('classPlanRevision' in request.resource.data);
    }

    function validSessionActivation() {
      return resource.data.status == 'allocating' && request.resource.data.status == 'live' &&
        request.resource.data.activationLeaseUntil is timestamp &&
        request.resource.data.activationLeaseUntil <= request.time + duration.value(120, 's') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'activationLeaseUntil'
        ]);
    }

    function validSessionHeartbeat() {
      return resource.data.status == 'live' && request.resource.data.status == 'live' &&
        request.resource.data.activationLeaseUntil is timestamp &&
        request.resource.data.activationLeaseUntil <= request.time + duration.value(120, 's') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activationLeaseUntil']);
    }

    function validSessionAbortTransition() {
      return !('classPlanId' in resource.data) && !('classPlanRevision' in resource.data) &&
        request.resource.data.status == 'aborted' &&
        request.resource.data.abortedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'abortedAt']) &&
        (resource.data.status in ['allocating', 'aborted'] ||
          (resource.data.status == 'live' &&
            resource.data.get('activationLeaseUntil', null) is timestamp &&
            request.time > resource.data.get('activationLeaseUntil', null)));
    }

    function validSessionEnd(sessionId) {
      let livePath = /databases/$(database)/documents/sessions/$(sessionId)/meta/live;
      return resource.data.status in ['active', 'live'] &&
        request.resource.data.status == 'ended' &&
        request.resource.data.endedAt == request.time &&
        request.resource.data.actualParticipants == resource.data.registeredStudentCount &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'endedAt', 'actualParticipants'
        ]) && existsAfter(livePath) && validEndedLiveData(getAfter(livePath).data);
    }

    function validSessionEndRepair(sessionId) {
      let livePath = /databases/$(database)/documents/sessions/$(sessionId)/meta/live;
      return resource.data.status == 'ended' && request.resource.data.status == 'ended' &&
        request.resource.data.actualParticipants == resource.data.registeredStudentCount &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actualParticipants']) &&
        existsAfter(livePath) && validEndedLiveData(getAfter(livePath).data);
    }

    function validLegacySessionEnd(sessionId) {
      let livePath = /databases/$(database)/documents/sessions/$(sessionId)/meta/live;
      return resource.data.status in ['active', 'live'] &&
        request.resource.data.status == 'ended' &&
        request.resource.data.endedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'endedAt'
        ]) && existsAfter(livePath) && validEndedLiveData(getAfter(livePath).data);
    }

    function validLegacySessionTransition(sessionId) {
      return legacySessionCounterCompatibilityOpen() &&
        legacySessionWithoutCounters(resource.data) &&
        legacySessionWithoutCounters(request.resource.data) &&
        (validSessionActivation() || validSessionHeartbeat() ||
          validSessionAbortTransition() || validLegacySessionEnd(sessionId));
    }

    function validOwnedSessionUpdate(sessionId) {
      return ownsSession(sessionId) &&
        (sessionHasCounterFields(resource.data)
          ? sessionHasCounterFields(request.resource.data) &&
            validSessionCounter(resource.data) && validSessionCounter(request.resource.data) && (
              validSessionActivation() || validSessionHeartbeat() ||
              validSessionAbortTransition() || validSessionEnd(sessionId) ||
              validSessionEndRepair(sessionId) || validSessionPlanAttach(sessionId) ||
              validSessionPlanFinish(sessionId)
            )
          : validLegacySessionTransition(sessionId));
    }

    function validDeletionPendingSessionEnd(sessionId) {
      return ownsSessionForSafeDeletionEnd(sessionId) &&
        (sessionHasCounterFields(resource.data)
          ? sessionHasCounterFields(request.resource.data) &&
            validSessionCounter(resource.data) && validSessionCounter(request.resource.data) &&
            (validSessionEnd(sessionId) || validSessionEndRepair(sessionId) ||
              validSessionPlanFinish(sessionId))
          : validLegacySessionTransition(sessionId) &&
            request.resource.data.status == 'ended');
    }

    function validDeletionPendingSessionAbort(sessionId) {
      return ownsSessionForSafeDeletionEnd(sessionId) &&
        resource.data.status == 'allocating' &&
        sessionHasCounterFields(resource.data) &&
        sessionHasCounterFields(request.resource.data) &&
        validSessionCounter(resource.data) && validSessionCounter(request.resource.data) &&
        validSessionAbortTransition();
    }

    function validStudentCounterIncrement(sessionId) {
      let studentPath = /databases/$(database)/documents/sessions/$(sessionId)/students/$(request.auth.uid);
      return anonymousStudent() && resource.data.status in ['active', 'live'] &&
        resource.data.get('activationLeaseUntil', null) is timestamp &&
        request.time <= resource.data.get('activationLeaseUntil', null) &&
        resource.data.registeredStudentCount is int && resource.data.registeredStudentCount >= 0 &&
        resource.data.studentCountRevision == resource.data.registeredStudentCount &&
        !exists(studentPath) && existsAfter(studentPath) &&
        getAfter(studentPath).data.uid == request.auth.uid &&
        request.resource.data.registeredStudentCount == resource.data.registeredStudentCount + 1 &&
        request.resource.data.studentCountRevision == resource.data.studentCountRevision + 1 &&
        request.resource.data.lastStudentUid == request.auth.uid &&
        validAttachedPublicPlanCountIncrement(sessionId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'registeredStudentCount', 'studentCountRevision', 'lastStudentUid'
        ]);
    }

    function validAttachedPublicPlanCountIncrement(sessionId) {
      let attached = 'classPlanId' in resource.data || 'classPlanRevision' in resource.data;
      let planId = resource.data.get('classPlanId', '');
      let publicPath = classPlanPublicPath(planId);
      let publicBefore = attached && exists(publicPath) ? get(publicPath).data : {};
      let publicAfter = attached && existsAfter(publicPath) ? getAfter(publicPath).data : {};
      return attached ? (
        resource.data.classPlanId is string && resource.data.classPlanRevision is int &&
        request.resource.data.classPlanId == resource.data.classPlanId &&
        request.resource.data.classPlanRevision == resource.data.classPlanRevision &&
        publicBefore.planId == planId && publicBefore.status == 'live' &&
        publicBefore.sessionId == sessionId &&
        publicBefore.revision == resource.data.classPlanRevision &&
        publicBefore.get('actualParticipants', 0) ==
          resource.data.registeredStudentCount &&
        publicAfter.actualParticipants ==
          request.resource.data.registeredStudentCount &&
        publicAfter.diff(publicBefore).affectedKeys().hasOnly([
          'actualParticipants'
        ])
      ) : true;
    }

    function validSessionPlanAttach(sessionId) {
      let planId = request.resource.data.classPlanId;
      let privatePath = classPlanPrivatePath(planId);
      return !('classPlanId' in resource.data) && !('classPlanRevision' in resource.data) &&
        planId is string && request.resource.data.classPlanRevision is int &&
        existsAfter(privatePath) &&
        getAfter(privatePath).data.sessionId == sessionId &&
        getAfter(privatePath).data.status == 'live' &&
        getAfter(privatePath).data.revision == request.resource.data.classPlanRevision &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'classPlanId', 'classPlanRevision'
        ]);
    }

    function validSessionPlanFinish(sessionId) {
      let privatePath = classPlanPrivatePath(resource.data.classPlanId);
      return resource.data.status == 'ended' && request.resource.data.status == 'ended' &&
        resource.data.classPlanRevision is int &&
        request.resource.data.classPlanId == resource.data.classPlanId &&
        request.resource.data.classPlanRevision == resource.data.classPlanRevision + 1 &&
        exists(privatePath) && existsAfter(privatePath) &&
        get(privatePath).data.sessionId == sessionId && get(privatePath).data.status == 'live' &&
        get(privatePath).data.revision == resource.data.classPlanRevision &&
        getAfter(privatePath).data.status == 'ended' &&
        getAfter(privatePath).data.revision == request.resource.data.classPlanRevision &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classPlanRevision']);
    }

    function classPlanPrivatePath(planId) {
      return /databases/$(database)/documents/class_plans_private/$(planId);
    }

    function classPlanPublicPath(planId) {
      return /databases/$(database)/documents/class_plans_public/$(planId);
    }

    function validClassPlanCommon(data, planId) {
      return data.planId == planId &&
        data.setId is string && data.setId.size() > 0 && data.setId.size() <= 128 &&
        data.setTitleSnapshot is string && data.setTitleSnapshot.size() > 0 &&
        data.setTitleSnapshot.size() <= 200 &&
        data.className is string && data.className.size() > 0 && data.className.size() <= 80 &&
        data.plannedStartAt is timestamp && data.plannedEndAt is timestamp &&
        data.plannedEndAt > data.plannedStartAt &&
        data.plannedEndAt <= data.plannedStartAt + duration.value(24, 'h') &&
        data.expectedStudents is int && data.expectedStudents >= 1 && data.expectedStudents <= 500 &&
        data.status in ['planned', 'live', 'ended', 'cancelled'] &&
        isPositiveSafeRevision(data.revision) &&
        data.createdAt is timestamp && data.updatedAt is timestamp && data.updatedAt >= data.createdAt &&
        (!('warningLevel' in data) || data.warningLevel in ['green', 'caution', 'crowded']) &&
        (!('warningAcknowledgedAt' in data) || data.warningAcknowledgedAt is timestamp) &&
        (!('sessionId' in data) ||
          (data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 128)) &&
        (!('actualStartedAt' in data) || data.actualStartedAt is timestamp) &&
        (!('actualEndedAt' in data) || data.actualEndedAt is timestamp) &&
        (!('actualParticipants' in data) ||
          (data.actualParticipants is int && data.actualParticipants >= 0)) &&
        (data.status in ['planned', 'cancelled']
          ? !('sessionId' in data) && !('actualStartedAt' in data) &&
            !('actualEndedAt' in data) && !('actualParticipants' in data)
          : data.status == 'live'
            ? ('sessionId' in data) && ('actualStartedAt' in data) &&
              !('actualEndedAt' in data)
            : ('sessionId' in data) && ('actualStartedAt' in data) &&
              ('actualEndedAt' in data) && ('actualParticipants' in data) &&
              data.actualEndedAt >= data.actualStartedAt);
    }

    function validClassPlanPrivate(data, planId) {
      return data.keys().hasAll([
          'planId', 'ownerUid', 'ownerEmailCanonical', 'ownerDisplayName',
          'setId', 'setTitleSnapshot', 'className', 'plannedStartAt', 'plannedEndAt',
          'expectedStudents', 'status', 'revision', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'planId', 'ownerUid', 'ownerEmailCanonical', 'ownerDisplayName',
          'setId', 'setTitleSnapshot', 'className', 'plannedStartAt', 'plannedEndAt',
          'expectedStudents', 'status', 'revision', 'createdAt', 'updatedAt',
          'warningLevel', 'warningAcknowledgedAt', 'sessionId', 'actualStartedAt',
          'actualEndedAt', 'actualParticipants'
        ]) && validClassPlanCommon(data, planId) &&
        data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 &&
        data.ownerEmailCanonical is string && canonicalAllowanceId(data.ownerEmailCanonical) &&
        data.ownerDisplayName is string && data.ownerDisplayName.size() > 0 &&
        data.ownerDisplayName.size() <= 80;
    }

    function validClassPlanPublic(data, planId) {
      return data.keys().hasAll([
          'planId', 'setId', 'setTitleSnapshot', 'className', 'plannedStartAt',
          'plannedEndAt', 'expectedStudents', 'status', 'revision', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'planId', 'setId', 'setTitleSnapshot', 'className', 'plannedStartAt',
          'plannedEndAt', 'expectedStudents', 'status', 'revision', 'createdAt', 'updatedAt',
          'warningLevel', 'warningAcknowledgedAt', 'sessionId', 'actualStartedAt',
          'actualEndedAt', 'actualParticipants'
        ]) && validClassPlanCommon(data, planId);
    }

    function classPlanPublicKeysOnly(data) {
      return data.keys().hasAll([
          'planId', 'setId', 'setTitleSnapshot', 'className', 'plannedStartAt',
          'plannedEndAt', 'expectedStudents', 'status', 'revision', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'planId', 'setId', 'setTitleSnapshot', 'className', 'plannedStartAt',
          'plannedEndAt', 'expectedStudents', 'status', 'revision', 'createdAt', 'updatedAt',
          'warningLevel', 'warningAcknowledgedAt', 'sessionId', 'actualStartedAt',
          'actualEndedAt', 'actualParticipants'
        ]);
    }

    function matchingClassPlanPair(privateData, publicData) {
      return [
          publicData.planId, publicData.setId, publicData.setTitleSnapshot,
          publicData.className, publicData.plannedStartAt, publicData.plannedEndAt,
          publicData.expectedStudents, publicData.status, publicData.revision,
          publicData.createdAt, publicData.updatedAt,
          publicData.get('warningLevel', null),
          publicData.get('warningAcknowledgedAt', null),
          publicData.get('sessionId', null), publicData.get('actualStartedAt', null),
          publicData.get('actualEndedAt', null)
        ] == [
          privateData.planId, privateData.setId, privateData.setTitleSnapshot,
          privateData.className, privateData.plannedStartAt, privateData.plannedEndAt,
          privateData.expectedStudents, privateData.status, privateData.revision,
          privateData.createdAt, privateData.updatedAt,
          privateData.get('warningLevel', null),
          privateData.get('warningAcknowledgedAt', null),
          privateData.get('sessionId', null), privateData.get('actualStartedAt', null),
          privateData.get('actualEndedAt', null)
        ] && (publicData.get('actualParticipants', null) == privateData.get('actualParticipants', null) ||
          (privateData.status == 'live' && !('actualParticipants' in privateData) &&
            publicData.actualParticipants is int && publicData.actualParticipants >= 0));
    }

    function validClassPlanPairAfter(planId) {
      let privatePath = classPlanPrivatePath(planId);
      let publicPath = classPlanPublicPath(planId);
      return existsAfter(privatePath) && existsAfter(publicPath) &&
        validClassPlanPrivate(getAfter(privatePath).data, planId) &&
        validClassPlanPublic(getAfter(publicPath).data, planId) &&
        matchingClassPlanPair(getAfter(privatePath).data, getAfter(publicPath).data);
    }

    function validClassPlanCreate(planId) {
      let privateData = getAfter(classPlanPrivatePath(planId)).data;
      return isApprovedTeacher() && validClassPlanPairAfter(planId) &&
        privateData.ownerUid == request.auth.uid &&
        privateData.ownerEmailCanonical == request.auth.token.email &&
        privateData.status == 'planned' && privateData.revision == 1 &&
        privateData.createdAt == request.time && privateData.updatedAt == request.time;
    }

    function sameClassPlanIdentity(beforeData, afterData) {
      return [
          afterData.planId, afterData.ownerUid, afterData.ownerEmailCanonical,
          afterData.ownerDisplayName, afterData.setId, afterData.setTitleSnapshot,
          afterData.createdAt
        ] == [
          beforeData.planId, beforeData.ownerUid, beforeData.ownerEmailCanonical,
          beforeData.ownerDisplayName, beforeData.setId, beforeData.setTitleSnapshot,
          beforeData.createdAt
        ];
    }

    function validPlannedClassPlanTransition(beforeData, afterData) {
      return (afterData.status == 'planned' &&
          afterData.diff(beforeData).affectedKeys().hasOnly([
            'className', 'plannedStartAt', 'plannedEndAt', 'expectedStudents',
            'warningLevel', 'warningAcknowledgedAt', 'revision', 'updatedAt'
          ])) ||
        (afterData.status == 'cancelled' &&
          afterData.diff(beforeData).affectedKeys().hasOnly(['status', 'revision', 'updatedAt']));
    }

    function validClassPlanAttach(beforeData, afterData) {
      let sessionPath = /databases/$(database)/documents/sessions/$(afterData.sessionId);
      let publicAfter = getAfter(classPlanPublicPath(afterData.planId)).data;
      return afterData.status == 'live' && exists(sessionPath) && existsAfter(sessionPath) &&
        get(sessionPath).data.teacherUid == beforeData.ownerUid &&
        get(sessionPath).data.get('teacherEmail', '') == beforeData.ownerEmailCanonical &&
        get(sessionPath).data.setId == beforeData.setId &&
        get(sessionPath).data.status == 'live' &&
        publicAfter.actualParticipants == get(sessionPath).data.registeredStudentCount &&
        getAfter(sessionPath).data.classPlanId == afterData.planId &&
        getAfter(sessionPath).data.classPlanRevision == afterData.revision &&
        afterData.actualStartedAt == get(sessionPath).data.createdAt &&
        afterData.diff(beforeData).affectedKeys().hasOnly([
          'status', 'sessionId', 'actualStartedAt', 'revision', 'updatedAt'
        ]);
    }

    function validClassPlanFinish(beforeData, afterData) {
      let sessionPath = /databases/$(database)/documents/sessions/$(beforeData.sessionId);
      return afterData.status == 'ended' && afterData.sessionId == beforeData.sessionId &&
        exists(sessionPath) && existsAfter(sessionPath) &&
        get(sessionPath).data.teacherUid == beforeData.ownerUid &&
        get(sessionPath).data.setId == beforeData.setId &&
        get(sessionPath).data.status == 'ended' &&
        validSessionCounter(get(sessionPath).data) &&
        get(sessionPath).data.classPlanId == beforeData.planId &&
        get(sessionPath).data.classPlanRevision == beforeData.revision &&
        getAfter(sessionPath).data.classPlanRevision == afterData.revision &&
        afterData.actualStartedAt == beforeData.actualStartedAt &&
        afterData.actualEndedAt == get(sessionPath).data.endedAt &&
        get(sessionPath).data.get('actualParticipants', -1) == afterData.actualParticipants &&
        get(sessionPath).data.registeredStudentCount == afterData.actualParticipants &&
        afterData.diff(beforeData).affectedKeys().hasOnly([
          'status', 'actualEndedAt', 'actualParticipants', 'revision', 'updatedAt'
        ]);
    }

    function validApprovedClassPlanUpdate(planId) {
      let beforeData = get(classPlanPrivatePath(planId)).data;
      let afterData = getAfter(classPlanPrivatePath(planId)).data;
      let publicAfter = getAfter(classPlanPublicPath(planId)).data;
      return isApprovedTeacher() && validClassPlanPrivate(afterData, planId) &&
        classPlanPublicKeysOnly(publicAfter) && matchingClassPlanPair(afterData, publicAfter) &&
        beforeData.ownerUid == request.auth.uid &&
        beforeData.ownerEmailCanonical == request.auth.token.email &&
        sameClassPlanIdentity(beforeData, afterData) &&
        afterData.revision == beforeData.revision + 1 &&
        afterData.updatedAt == request.time &&
        (beforeData.status == 'planned'
          ? validPlannedClassPlanTransition(beforeData, afterData) ||
            validClassPlanAttach(beforeData, afterData)
          : beforeData.status == 'live' && validClassPlanFinish(beforeData, afterData));
    }

    function validDeletionPendingClassPlanFinish(planId) {
      let beforeData = get(classPlanPrivatePath(planId)).data;
      let afterData = getAfter(classPlanPrivatePath(planId)).data;
      let publicBefore = get(classPlanPublicPath(planId)).data;
      let publicAfter = getAfter(classPlanPublicPath(planId)).data;
      return isStoppedTeacherForSafeEnd() &&
        beforeData.ownerUid == request.auth.uid &&
        beforeData.ownerEmailCanonical == request.auth.token.email &&
        beforeData.status == 'live' && afterData.status == 'ended' &&
        sameClassPlanIdentity(beforeData, afterData) &&
        afterData.revision == beforeData.revision + 1 &&
        afterData.updatedAt == request.time &&
        publicAfter.diff(publicBefore).affectedKeys().hasOnly([
          'status', 'actualEndedAt', 'actualParticipants', 'revision', 'updatedAt'
        ]) && matchingClassPlanPair(afterData, publicAfter) &&
        validClassPlanFinish(beforeData, afterData);
    }

    function validClassPlanUpdate(planId) {
      let allowancePath = teacherAllowancePath();
      let stopped = exists(allowancePath) &&
        get(allowancePath).data.status in ['deletion_pending', 'suspended'];
      return stopped
        ? validDeletionPendingClassPlanFinish(planId)
        : validApprovedClassPlanUpdate(planId);
    }

    function validStudentPublicPlanCountUpdate(planId) {
      let sessionPath = /databases/$(database)/documents/sessions/$(resource.data.sessionId);
      let studentPath = /databases/$(database)/documents/sessions/$(resource.data.sessionId)/students/$(request.auth.uid);
      let sessionBefore = exists(sessionPath) ? get(sessionPath).data : {};
      let sessionAfter = existsAfter(sessionPath) ? getAfter(sessionPath).data : {};
      return anonymousStudent() && resource.data.planId == planId &&
        resource.data.status == 'live' && resource.data.sessionId is string &&
        sessionBefore.classPlanId == planId &&
        sessionBefore.classPlanRevision == resource.data.revision &&
        sessionAfter.classPlanId == planId &&
        sessionAfter.classPlanRevision == resource.data.revision &&
        sessionAfter.registeredStudentCount == sessionBefore.registeredStudentCount + 1 &&
        sessionAfter.studentCountRevision == sessionBefore.studentCountRevision + 1 &&
        !exists(studentPath) && existsAfter(studentPath) &&
        getAfter(studentPath).data.uid == request.auth.uid &&
        request.resource.data.actualParticipants == sessionAfter.registeredStudentCount &&
        resource.data.get('actualParticipants', 0) == sessionBefore.registeredStudentCount &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actualParticipants']);
    }

    function validClassPlanPublicMirrorUpdate(planId) {
      let privateBefore = get(classPlanPrivatePath(planId)).data;
      let privateAfter = getAfter(classPlanPrivatePath(planId)).data;
      return (isApprovedTeacher() || isStoppedTeacherForSafeEnd()) &&
        privateBefore.ownerUid == request.auth.uid &&
        privateBefore.ownerEmailCanonical == request.auth.token.email &&
        privateBefore.revision == resource.data.revision &&
        privateAfter.revision == resource.data.revision + 1 &&
        privateAfter.updatedAt == request.time &&
        validClassPlanPublic(request.resource.data, planId) &&
        matchingClassPlanPair(privateAfter, request.resource.data);
    }

    match /teacher_access_requests/{uid} {
      allow get: if isOwnTeacherRequest(uid) || isAdmin();
      allow list: if isAdmin() && resource.data.status == 'pending' &&
        request.query.limit != null && request.query.limit <= 100;
      allow create: if validPendingTeacherRequest(uid);
      allow update: if validOwnTeacherRequestCancellation(uid) ||
        validOwnTeacherRequestResubmission(uid) ||
        validAdminRequestDecision(uid);
      allow delete: if false;
      allow read, write: if false;
    }

    match /teacher_allowances/{uid} {
      allow get: if (verifiedEmail() && request.auth.uid == uid &&
          resource.data.uid == uid && resource.data.emailCanonical == request.auth.token.email) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && teacherAccessMigrationUnlocked() &&
        existsAfter(/databases/$(database)/documents/teacher_access_requests/$(uid)) &&
        validApprovedTeacherAllowance(
          uid,
          request.resource.data,
          getAfter(/databases/$(database)/documents/teacher_access_requests/$(uid)).data
        );
      allow update: if teacherAccessMigrationUnlocked() && validTeacherAllowanceUpdate(uid);
      allow delete: if false;
      allow read, write: if false;
    }

    match /teacher_allowlist/{email} {
      allow get, list: if isAdmin();
      allow create: if canonicalAllowanceId(email) &&
        (validAuthoritativeLegacyMirror(email) ||
          (!teacherAccessMigrationComplete() && teacherAccessMigrationUnlocked() && isAdmin() &&
            validAllowanceDocument(email)));
      allow update: if validOwnTeacherDeletionLegacyAllowance(email) ||
        validAuthoritativeLegacyMirror(email) ||
        (!teacherAccessMigrationComplete() && teacherAccessMigrationUnlocked() && isAdmin() &&
          canonicalAllowanceId(email) && validAllowanceDocument(email) && !protectsCurrentAdmin(email));
      allow delete: if false;
      allow read, write: if false;
    }

    match /migration_gates/set_counters {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin() && validCounterGateLock();
      allow update: if isAdmin() &&
        ((resource.data.get('locked', false) == false && validCounterGateLock() &&
            request.resource.data.lockId != resource.data.get('lockId', '')) ||
          validCounterGateUnlock());
      allow delete: if false;
      allow read, write: if false;
    }

    match /migration_gates/session_counters {
      allow get: if isStoppedTeacherForSafeEnd() || isApprovedTeacher() || isAdmin();
      allow list, create, update, delete: if false;
      allow read, write: if false;
    }

    match /migration_gates/session_counter_migration {
      allow get: if isAdmin();
      allow list, create, update, delete: if false;
      allow read, write: if false;
    }

    match /migration_gates/teacher_access_status {
      allow get: if isAdmin();
      allow list, create, update, delete: if false;
      allow read, write: if false;
    }

    match /class_plans_private/{planId} {
      allow get: if isAdmin() ||
        ((isApprovedTeacher() || isStoppedTeacherForSafeEnd()) &&
          resource.data.ownerUid == request.auth.uid);
      allow list: if (isAdmin() ||
          (isApprovedTeacher() && resource.data.ownerUid == request.auth.uid)) &&
        request.query.limit != null && request.query.limit <= 100 &&
        resource.data.plannedStartAt >= request.time - duration.value(1448, 'm') &&
        resource.data.plannedStartAt < request.time + duration.value(32, 'd');
      allow list: if isStoppedTeacherForSafeEnd() &&
        resource.data.ownerUid == request.auth.uid && resource.data.status == 'live' &&
        request.query.limit != null && request.query.limit <= 101;
      allow create: if validClassPlanCreate(planId);
      allow update: if validClassPlanUpdate(planId);
      allow delete: if false;
      allow read, write: if false;
    }

    match /class_plans_public/{planId} {
      allow get: if (isApprovedTeacher() ||
          (isStoppedTeacherForSafeEnd() && exists(classPlanPrivatePath(planId)) &&
            get(classPlanPrivatePath(planId)).data.ownerUid == request.auth.uid)) &&
        validClassPlanPublic(resource.data, planId);
      allow list: if isApprovedTeacher() && request.query.limit != null &&
        request.query.limit <= 100 &&
        resource.data.plannedStartAt >= request.time - duration.value(1448, 'm') &&
        resource.data.plannedStartAt < request.time + duration.value(32, 'd');
      allow create: if validClassPlanCreate(planId);
      allow update: if validStudentPublicPlanCountUpdate(planId) ||
        validClassPlanPublicMirrorUpdate(planId);
      allow delete: if false;
      allow read, write: if false;
    }

    match /publication_lifecycle_locks/{uid} {
      allow get: if isApprovedTeacher() && (request.auth.uid == uid || isAdmin());
      allow list: if false;
      allow create: if validPublicationLifecycleLockCreate(uid);
      allow update: if false;
      allow delete: if validPublicationLifecycleLockDelete(uid);
      allow read, write: if false;
    }

    match /publication_lifecycle_gates/current {
      allow get: if isAdmin() || (isApprovedTeacher() &&
        (!exists(/databases/$(database)/documents/publication_lifecycle_gates/current) ||
          resource.data.get('ownerUid', '') == request.auth.uid));
      allow list: if false;
      allow create: if validPublicationLifecycleGateCreate();
      allow update: if false;
      allow delete: if validPublicationLifecycleGateDelete();
      allow read, write: if false;
    }

    function validPublishedListQuery() {
      return request.query.limit != null && request.query.limit >= 1 &&
        request.query.limit <= 50 &&
        request.query.orderBy == {
          'updatedAt': 'DESC', '__name__': 'DESC'
        };
    }

    match /published_quiz_sets/{setId} {
      allow get: if validPublicationGet(setId);
      allow list: if validPublishedListQuery() &&
        (isAdmin()
          ? resource.data.status in ['published', 'moderated']
          : isApprovedTeacher() && resource.data.status == 'published' &&
            publicLifecycleGateOpen());
      allow create: if validBuildingCreate(setId);
      allow update: if validPublicParentUpdate(setId);
      allow delete: if false;
      allow read, write: if false;

      match /videos/{key} {
        allow get: if validPublicVideoGet(setId, key, resource.data);
        allow list: if validPublicVideoList(setId, key, resource.data);
        allow create, update: if validPublicVideoBind(setId, key);
        allow delete: if false;
        allow read, write: if false;
      }

      match /questions/{key} {
        allow get: if validPublicQuestionGet(setId, key, resource.data);
        allow list: if validPublicQuestionList(setId, key, resource.data);
        allow create, update: if validPublicQuestionBind(setId, key);
        allow delete: if false;
        allow read, write: if false;
      }

      match /images/{key} {
        allow get: if validPublicImageGet(setId, key, resource.data);
        allow list: if validPublicImageList(setId, key, resource.data);
        allow create, update: if validPublicImageBind(setId, key);
        allow delete: if validPublicImagePurgeDelete(setId, key);
        allow read, write: if false;
      }
    }

    match /published_quiz_audits/{setId} {
      allow get, list: if isAdmin();
      allow create, update: if validPublicationAuditWrite(setId);
      allow delete: if false;
      allow read, write: if false;
    }

    match /quiz_sets/{setId} {
      allow get: if !exists(publicationSourcePath(setId))
        ? isApprovedTeacher()
        : canReadPrivateSet(setId);
      allow list: if (isAdmin() &&
          resource.data.keys().hasAll(['lifecycleState']) &&
          (resource.data.lifecycleState == 'active' ||
            resource.data.lifecycleState in ['trashed', 'purging'])) ||
        (isApprovedTeacher() &&
          resource.data.keys().hasAll(['lifecycleState', 'ownerUid']) &&
          resource.data.ownerUid == request.auth.uid &&
          resource.data.lifecycleState in ['active', 'trashed', 'purging']) ||
        (isAdmin() && resource.data.keys().hasAll(['ownerUid']) &&
          request.query.limit != null && request.query.limit <= 50) ||
        (isApprovedTeacher() && resource.data.keys().hasAll(['ownerUid']) &&
          resource.data.ownerUid == request.auth.uid &&
          request.query.limit != null && request.query.limit <= 50) ||
        (isStoppedTeacherForSafeEnd() &&
          resource.data.keys().hasAll(['ownerUid']) &&
          resource.data.ownerUid == request.auth.uid &&
          request.query.limit != null && request.query.limit <= 101);
      allow create: if validPrivateCopyStart(setId) || (isApprovedTeacher() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerEmail == request.auth.token.email &&
        request.resource.data.lifecycleState == 'active' &&
        request.resource.data.keys().hasAll(['collaboratorCount', 'imageCount']) &&
        request.resource.data.collaboratorCount == 0 &&
        request.resource.data.imageCount == 0 &&
        !('collaboratorMutation' in request.resource.data) &&
        !('imageMutation' in request.resource.data) &&
        !('trashedAt' in request.resource.data) &&
        !('purgeStartedAt' in request.resource.data) &&
        !request.resource.data.keys().hasAny([
          'publicationId', 'sourcePublicationRevision', 'sourceTitle',
          'sourceAuthorDisplayName', 'visibility', 'copyStatus'
        ]));
      allow update: if validPrivateSetUpdate(setId);
      allow delete: if canPurgeSet(setId) &&
        counterMigrationUnlocked() &&
        validAuthoritativeCounters(resource.data) &&
        resource.data.get('collaboratorCount', -1) == 0 &&
        resource.data.get('imageCount', -1) == 0;
      allow read, write: if false;
    }

    match /quiz_sets/{setId}/collaborators/{email} {
      allow get: if ((ownsSet(setId) || canPurgeSet(setId)) &&
          (!exists(/databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(email)) ||
            validStoredCollaboratorData(resource.data, email))) ||
        (validStoredCollaboratorData(resource.data, email) && isSetCollaborator(setId));
      allow list: if ownsSet(setId) || canPurgeSet(setId);
      allow create: if counterMigrationUnlocked() && ownsSet(setId) && activeSet(setId) &&
        !exists(/databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(email)) &&
        canonicalAllowanceId(email) &&
        email != get(/databases/$(database)/documents/quiz_sets/$(setId)).data.get('ownerEmail', '') &&
        validCollaboratorData(email) &&
        validCollaboratorMutation(setId, email, 'add') &&
        validCollaboratorShareAfter(setId, email, 'add');
      allow delete: if counterMigrationUnlocked() &&
        validStoredCollaboratorData(resource.data, email) &&
        validCollaboratorShareAfter(setId, email, 'remove') &&
        ((ownsSet(setId) && activeSet(setId) &&
          validCollaboratorMutation(setId, email, 'remove')) ||
          validPurgeCollaboratorDelete(setId, email));
      allow update: if false;
      allow read, write: if false;
    }

    match /quiz_set_shares/{email}/sets/{setId} {
      allow get: if isApprovedTeacher() && email == request.auth.token.email &&
        validCollaboratorShareData(resource.data, setId, email);
      allow list: if isApprovedTeacher() && email == request.auth.token.email &&
        request.query.limit != null && request.query.limit >= 1 &&
        request.query.limit <= 50;
      allow create: if counterMigrationUnlocked() && ownsSet(setId) && activeSet(setId) &&
        validCollaboratorShareData(request.resource.data, setId, email) &&
        !exists(/databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(email)) &&
        existsAfter(/databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(email)) &&
        validStoredCollaboratorData(
          getAfter(/databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(email)).data,
          email
        ) && validCollaboratorMutation(setId, email, 'add');
      allow delete: if counterMigrationUnlocked() &&
        exists(/databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(email)) &&
        !existsAfter(/databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(email)) &&
        ((ownsSet(setId) && activeSet(setId) &&
          validCollaboratorMutation(setId, email, 'remove')) ||
          validPurgeCollaboratorDelete(setId, email));
      allow update: if false;
      allow read, write: if false;
    }

    match /images/{setId}/q/{questionIndex} {
      allow get, list: if canReadPrivateSet(setId) || canPurgeSet(setId);
      allow create: if validPrivateImageCreate(setId, questionIndex);
      allow update: if counterMigrationUnlocked() && validActiveImageUpdate(setId, questionIndex);
      allow delete: if counterMigrationUnlocked() &&
        (validActiveImageDelete(setId, questionIndex) || validPurgeImageDelete(setId, questionIndex));
      allow read, write: if false;
    }

    match /codes/{code} {
      allow get: if anonymousStudent() || isApprovedTeacher();
      allow list: if isAdmin() || ownsSession(resource.data.sessionId);
      allow create: if ownsSessionAfter(request.resource.data.sessionId);
      allow update: if ownsSession(resource.data.sessionId) &&
        ownsSessionAfter(request.resource.data.sessionId);
      allow delete: if isAdmin() || ownsSession(resource.data.sessionId);
      allow read, write: if false;
    }

    match /sessions/{sessionId} {
      allow get: if ownsSessionForSafeDeletionEnd(sessionId) || ownsSession(sessionId) || isAdmin() ||
        (isApprovedTeacher() && !sessionExists(sessionId)) ||
        (anonymousStudent() &&
          (sessionIsJoinable(sessionId) || isRegisteredStudent(sessionId)));
      allow list: if isAdmin() ||
        (isApprovedTeacher() && resource.data.teacherUid == request.auth.uid) ||
          (isStoppedTeacherForSafeEnd() && resource.data.teacherUid == request.auth.uid &&
          resource.data.status in ['allocating', 'active', 'live'] && request.query.limit != null &&
          request.query.limit <= 101);
      allow create: if isApprovedTeacher() &&
        request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.teacherEmail == request.auth.token.email &&
        validSessionCreateCounter() &&
        (!('setId' in request.resource.data) ||
          (request.resource.data.setId is string &&
            exists(/databases/$(database)/documents/quiz_sets/$(request.resource.data.setId)) &&
            canStartSet(request.resource.data.setId))) &&
        (request.resource.data.status != 'live' ||
          (request.resource.data.get('activationLeaseUntil', null) is timestamp &&
            request.resource.data.get('activationLeaseUntil', null) <=
              request.time + duration.value(120, 's')));
      allow update: if request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.teacherEmail == resource.data.teacherEmail &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'registeredStudentCount', 'studentCountRevision', 'lastStudentUid'
        ]) && validStudentCounterIncrement(sessionId);
      allow update: if request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.teacherEmail == resource.data.teacherEmail &&
        !request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'registeredStudentCount', 'studentCountRevision', 'lastStudentUid'
        ]) && (validDeletionPendingSessionEnd(sessionId) || validOwnedSessionUpdate(sessionId));
      allow update: if request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.teacherEmail == resource.data.teacherEmail &&
        validDeletionPendingSessionAbort(sessionId);
      allow delete: if !('classPlanId' in resource.data) &&
        !('classPlanRevision' in resource.data) &&
        (isAdmin() || (ownsSession(sessionId) && resource.data.status == 'aborted' &&
          (sessionHasCounterFields(resource.data)
            ? validSessionCounter(resource.data)
            : legacySessionCounterCompatibilityOpen() &&
              legacySessionWithoutCounters(resource.data))));
      allow read, write: if false;

      match /meta/allocation {
        allow get, list: if isAdmin() || ownsSession(sessionId);
        allow create: if ownsSessionAfter(sessionId) &&
          request.resource.data.keys().hasOnly(['token', 'ownerUid']) &&
          request.resource.data.token is string &&
          request.resource.data.token.size() >= 16 &&
          request.resource.data.token.size() <= 128 &&
          request.resource.data.ownerUid == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin() ||
          (ownsSession(sessionId) &&
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'aborted');
        allow read, write: if false;
      }

      match /meta/live {
        allow get: if ownsSessionForSafeDeletionEnd(sessionId) || ownsSession(sessionId) || isAdmin() ||
          (isRegisteredStudent(sessionId) &&
            (validLiveData(resource.data) || validEndedLiveData(resource.data)));
        allow list: if isAdmin() || ownsSession(sessionId);
        allow create: if ownsSessionAfter(sessionId) && validLiveData(request.resource.data);
        allow update: if ownsSessionAfterForLiveMutation(sessionId) &&
          ((validLiveData(request.resource.data) &&
              validLiveUpdateTransition() && validAcceptingTransition()) ||
            validAtomicSessionEndLive(sessionId));
        allow delete: if isAdmin() || ownsSession(sessionId);
        allow read, write: if false;
      }

      match /meta/board {
        allow get: if isAdmin() || ownsSession(sessionId);
        allow list: if isAdmin() || ownsSession(sessionId);
        allow create, update: if ownsSessionAfter(sessionId);
        allow delete: if isAdmin() || ownsSession(sessionId);
        allow read, write: if false;
      }

      match /meta/{document} {
        allow list: if isAdmin() || ownsSession(sessionId);
        allow get, write: if false;
      }

      match /students/{studentId} {
        allow get: if isAdmin() || ownsSession(sessionId) ||
          (anonymousStudent() &&
            studentId == request.auth.uid &&
            (sessionIsJoinable(sessionId) || isRegisteredStudent(sessionId)));
        allow list: if isAdmin() || ownsSession(sessionId);
        allow create: if sessionCounterMigrationUnlocked() &&
          anonymousStudent() && validStudent(studentId) &&
          existsAfter(/databases/$(database)/documents/sessions/$(sessionId)) &&
          getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.registeredStudentCount ==
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.registeredStudentCount + 1 &&
          getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.studentCountRevision ==
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentCountRevision + 1 &&
          getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.lastStudentUid ==
            request.auth.uid;
        allow update: if isJoinedStudent(sessionId) &&
          sessionIsJoinable(sessionId) &&
          validStudent(studentId) &&
          request.resource.data.uid == resource.data.uid;
        allow delete: if sessionCounterMigrationUnlocked() &&
          (isAdmin() || ownsSession(sessionId)) &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.status in
            ['ended', 'aborted'];
        allow read, write: if false;
      }

      match /responses/{studentId} {
        allow get: if isAdmin() || ownsSession(sessionId) ||
          (isRegisteredStudent(sessionId) && studentId == request.auth.uid);
        allow list: if isAdmin() || ownsSession(sessionId);
        allow create: if isJoinedStudent(sessionId) &&
          sessionIsJoinable(sessionId) &&
          studentId == request.auth.uid &&
          validStudentResponseCreate(sessionId);
        allow update: if isJoinedStudent(sessionId) &&
          sessionIsJoinable(sessionId) &&
          studentId == request.auth.uid &&
          validStudentResponseUpdate(sessionId);
        allow delete: if isAdmin() || ownsSession(sessionId);
        allow read, write: if false;
      }

      match /grades/{gradeId} {
        allow get, list: if isAdmin() || ownsSession(sessionId);
        allow create: if (isAdmin() || ownsSessionAfter(sessionId)) && validGrade(gradeId);
        allow update: if (isAdmin() || ownsSessionAfter(sessionId)) &&
          validGrade(gradeId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.questionIndex == resource.data.questionIndex;
        allow delete: if isAdmin() || ownsSession(sessionId);
        allow read, write: if false;
      }

      match /student_scores/{studentId} {
        allow get: if isAdmin() || ownsSession(sessionId) ||
          (isRegisteredStudent(sessionId) && studentId == request.auth.uid);
        allow list: if isAdmin() || ownsSession(sessionId);
        allow create, update: if ownsSessionAfter(sessionId) && validStudentScore(studentId);
        allow delete: if isAdmin() || ownsSession(sessionId);
        allow read, write: if false;
      }

      match /snapshot/{document} {
        allow get, list: if isAdmin() || ownsSession(sessionId);
        allow create, update: if ownsSessionAfter(sessionId);
        allow delete: if isAdmin() || ownsSession(sessionId);
        allow read, write: if false;
      }

      match /snapshot_images/{questionKey} {
        allow get, list: if isAdmin() || ownsSession(sessionId);
        allow create, update: if ownsSessionAfter(sessionId);
        allow delete: if isAdmin() || ownsSession(sessionId);
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /config/class_planning {
      allow get: if isApprovedTeacher();
      allow list, delete: if false;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['caution', 'crowded', 'updatedAt', 'updatedByUid']) &&
        request.resource.data.keys().hasOnly(['caution', 'crowded', 'updatedAt', 'updatedByUid']) &&
        request.resource.data.caution is int && request.resource.data.caution >= 1 &&
        request.resource.data.crowded is int &&
        request.resource.data.crowded > request.resource.data.caution &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedByUid == request.auth.uid;
      allow read, write: if false;
    }

    match /config/{document} {
      allow list: if false;
      allow get, create, update, delete: if isAdmin() &&
        document != 'legacy_owner' && document != 'class_planning';
      allow read, write: if false;
    }

    match /clock/{sampleId} {
      allow get, create, update, delete: if signedIn() &&
        sampleId.matches('^' + request.auth.uid + '-[A-Za-z0-9]+$');
      allow list: if false;
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
