rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function anonymousStudent() {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function supportedTeacherProvider() {
      return request.auth.token.firebase.sign_in_provider in ['google.com', 'password'];
    }

    function verifiedEmail() {
      return request.auth != null && request.auth.token.email is string &&
        request.auth.token.email_verified == true && supportedTeacherProvider();
    }

    function legacyAllowancePath() {
      return /databases/$(database)/documents/teacher_allowlist/$(request.auth.token.email);
    }

    function teacherAllowancePath() {
      return /databases/$(database)/documents/teacher_allowances/$(request.auth.uid);
    }

    function validActiveTeacherAllowance(data) {
      return [data.uid, data.emailCanonical, data.status] ==
        [request.auth.uid, request.auth.token.email, 'active'] &&
        data.role in ['teacher', 'admin'];
    }

    function validLegacyTeacherAllowance() {
      return request.auth.token.firebase.sign_in_provider == 'google.com' &&
        exists(legacyAllowancePath()) &&
        get(legacyAllowancePath()).data.enabled == true &&
        get(legacyAllowancePath()).data.role in ['teacher', 'admin'];
    }

    function isApprovedTeacher() {
      let currentExists = exists(teacherAllowancePath());
      return verifiedEmail() && (currentExists
        ? validActiveTeacherAllowance(get(teacherAllowancePath()).data)
        : !teacherAccessMigrationComplete() && validLegacyTeacherAllowance());
    }

    function isDeletionPendingTeacher() {
      let currentExists = exists(teacherAllowancePath());
      let data = currentExists ? get(teacherAllowancePath()).data : {};
      return verifiedEmail() && currentExists &&
        [data.uid, data.emailCanonical, data.status, data.enabled, data.role] ==
          [request.auth.uid, request.auth.token.get('email', ''),
            'deletion_pending', false, 'teacher'] &&
        data.administrativeHold is bool && data.revision is int && data.revision > 0 &&
        data.deletionRequestedAt is timestamp;
    }

    function isSuspendedTeacher() {
      let currentExists = exists(teacherAllowancePath());
      let data = currentExists ? get(teacherAllowancePath()).data : {};
      return verifiedEmail() && currentExists &&
        [data.uid, data.emailCanonical, data.status, data.enabled, data.role] ==
          [request.auth.uid, request.auth.token.get('email', ''),
            'suspended', false, 'teacher'] &&
        data.administrativeHold == true && data.revision is int && data.revision > 0;
    }

    function isStoppedTeacherForSafeEnd() {
      return isDeletionPendingTeacher() || isSuspendedTeacher();
    }

    function isAdmin() {
      let currentExists = exists(teacherAllowancePath());
      let approved = currentExists
        ? validActiveTeacherAllowance(get(teacherAllowancePath()).data)
        : !teacherAccessMigrationComplete() && validLegacyTeacherAllowance();
      return verifiedEmail() && approved &&
        (currentExists
          ? get(teacherAllowancePath()).data.role
          : get(legacyAllowancePath()).data.role) == 'admin';
    }

    function canonicalAllowanceId(email) {
      return email.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+$');
    }

    function validPublicAuthorLabel(label, email, uid) {
      return label is string && label == label.trim() &&
        label.size() >= 1 && label.size() <= 80 &&
        !label.matches('^([^ @]+@[^ @]+|[A-Za-z0-9_-]{20,128})$') &&
        !(label in [email, uid]);
    }

    function validAllowanceDocument(email) {
      return request.resource.data.keys().hasOnly([
          'enabled', 'role', 'updatedAt', 'updatedByUid'
        ]) &&
        request.resource.data.enabled is bool &&
        request.resource.data.role in ['teacher', 'admin'] &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedByUid == request.auth.uid;
    }

    function protectsCurrentAdmin(email) {
      return email == request.auth.token.email &&
        resource.data.get('role', null) == 'admin' &&
        (!request.resource.data.enabled || request.resource.data.role != 'admin');
    }

    function isPositiveSafeRevision(value) {
      return value is int && value > 0 && value <= 9007199254740991;
    }

    function validTeacherRequestProfile(data, uid) {
      return data.uid == uid &&
        data.emailCanonical is string && canonicalAllowanceId(data.emailCanonical) &&
        data.displayName is string && data.displayName.size() >= 1 &&
        data.displayName.size() <= 80 &&
        data.organization is string && data.organization.size() <= 120 &&
        data.note is string && data.note.size() <= 500 &&
        data.status in ['pending', 'approved', 'rejected', 'cancelled'] &&
        isPositiveSafeRevision(data.revision) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isOwnTeacherRequest(uid) {
      return verifiedEmail() && request.auth.uid == uid;
    }

    function validPendingTeacherRequest(uid) {
      let data = request.resource.data;
      return isOwnTeacherRequest(uid) &&
        !exists(teacherAllowancePath()) && !exists(legacyAllowancePath()) &&
        data.keys().hasOnly([
          'uid', 'emailCanonical', 'displayName', 'organization', 'note',
          'status', 'revision', 'createdAt', 'updatedAt'
        ]) &&
        validTeacherRequestProfile(data, uid) &&
        data.emailCanonical == request.auth.token.email &&
        validPublicAuthorLabel(data.displayName, data.emailCanonical, uid) &&
        data.status == 'pending' && data.revision == 1 &&
        data.createdAt == request.time && data.updatedAt == request.time;
    }

    function validOwnTeacherRequestCancellation(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return isOwnTeacherRequest(uid) &&
        before.keys().hasOnly([
          'uid', 'emailCanonical', 'displayName', 'organization', 'note',
          'status', 'revision', 'createdAt', 'updatedAt'
        ]) &&
        after.keys().hasOnly([
          'uid', 'emailCanonical', 'displayName', 'organization', 'note',
          'status', 'revision', 'createdAt', 'updatedAt'
        ]) &&
        validTeacherRequestProfile(before, uid) && validTeacherRequestProfile(after, uid) &&
        before.emailCanonical == request.auth.token.email &&
        before.status == 'pending' && after.status == 'cancelled' &&
        after.revision == before.revision + 1 &&
        after.createdAt == before.createdAt && after.updatedAt == request.time &&
        after.diff(before).affectedKeys().hasOnly(['status', 'revision', 'updatedAt']);
    }

    function validOwnTeacherRequestResubmission(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return isOwnTeacherRequest(uid) &&
        !exists(teacherAllowancePath()) && !exists(legacyAllowancePath()) &&
        before.status in ['cancelled', 'rejected'] && after.status == 'pending' &&
        validTeacherRequestProfile(before, uid) && validTeacherRequestProfile(after, uid) &&
        before.emailCanonical == request.auth.token.email &&
        after.emailCanonical == before.emailCanonical && after.uid == before.uid &&
        after.displayName == before.displayName && after.createdAt == before.createdAt &&
        after.revision == before.revision + 1 && after.updatedAt == request.time &&
        !('decidedAt' in after) && !('decidedByUid' in after) &&
        !('decisionReason' in after) &&
        after.diff(before).affectedKeys().hasOnly([
          'organization', 'note', 'status', 'revision', 'updatedAt',
          'decidedAt', 'decidedByUid', 'decisionReason'
        ]);
    }

    function validApprovedTeacherAllowance(uid, data, requestData) {
      return data.keys().hasOnly([
          'uid', 'emailCanonical', 'displayName', 'status', 'enabled', 'role',
          'administrativeHold', 'approvedAt', 'approvedByUid', 'updatedAt', 'updatedByUid'
        ]) &&
        data.uid == uid && data.emailCanonical == requestData.emailCanonical &&
        data.displayName == requestData.displayName && data.status == 'active' &&
        validPublicAuthorLabel(data.displayName, data.emailCanonical, uid) &&
        data.enabled == true && data.role == 'teacher' &&
        data.administrativeHold == false &&
        data.approvedAt == request.time && data.approvedByUid == request.auth.uid &&
        data.updatedAt == request.time && data.updatedByUid == request.auth.uid &&
        requestData.status == 'approved' && requestData.decidedAt == request.time &&
        requestData.decidedByUid == request.auth.uid;
    }

    function validApprovedLegacyAllowance(uid, data) {
      return data.keys().hasOnly(['uid', 'enabled', 'role', 'updatedAt', 'updatedByUid']) &&
        data.uid == uid && data.enabled == true && data.role == 'teacher' &&
        data.updatedAt == request.time && data.updatedByUid == request.auth.uid;
    }

    function validAdminRequestDecision(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let allowanceTarget = /databases/$(database)/documents/teacher_allowances/$(uid);
      let legacyTarget = /databases/$(database)/documents/teacher_allowlist/$(after.emailCanonical);
      return isAdmin() && teacherAccessMigrationUnlocked() &&
        before.keys().hasOnly([
          'uid', 'emailCanonical', 'displayName', 'organization', 'note',
          'status', 'revision', 'createdAt', 'updatedAt'
        ]) &&
        after.keys().hasOnly([
          'uid', 'emailCanonical', 'displayName', 'organization', 'note',
          'status', 'revision', 'createdAt', 'updatedAt',
          'decidedAt', 'decidedByUid', 'decisionReason'
        ]) &&
        validTeacherRequestProfile(before, uid) && validTeacherRequestProfile(after, uid) &&
        before.status == 'pending' && after.status in ['approved', 'rejected'] &&
        after.revision == before.revision + 1 &&
        after.createdAt == before.createdAt && after.updatedAt == request.time &&
        after.decidedAt == request.time && after.decidedByUid == request.auth.uid &&
        after.decisionReason is string && after.decisionReason.size() <= 200 &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'revision', 'updatedAt', 'decidedAt', 'decidedByUid', 'decisionReason'
        ]) &&
        (after.status == 'rejected' ||
          ((!exists(legacyTarget) || get(legacyTarget).data.get('uid', '') == uid) &&
            existsAfter(allowanceTarget) && existsAfter(legacyTarget) &&
            validApprovedTeacherAllowance(uid, getAfter(allowanceTarget).data, after) &&
            validApprovedLegacyAllowance(uid, getAfter(legacyTarget).data)));
    }

    function validStoredTeacherAllowance(uid, data) {
      return data.uid == uid && data.emailCanonical is string &&
        canonicalAllowanceId(data.emailCanonical) &&
        data.displayName is string && data.displayName.size() >= 1 &&
        data.displayName.size() <= 80 &&
        data.status in ['active', 'suspended', 'deletion_pending'] &&
        data.enabled is bool && data.role in ['teacher', 'admin'] &&
        data.administrativeHold is bool && data.approvedAt is timestamp &&
        data.approvedByUid is string && data.approvedByUid.size() > 0 &&
        data.updatedAt is timestamp && data.updatedByUid is string &&
        data.updatedByUid.size() > 0 &&
        (!('revision' in data) || isPositiveSafeRevision(data.revision));
    }

    function validLifecycleLegacyAllowance(email, enabled) {
      let target = /databases/$(database)/documents/teacher_allowlist/$(email);
      return existsAfter(target) &&
        getAfter(target).data.keys().hasOnly(['uid', 'enabled', 'role', 'updatedAt', 'updatedByUid']) &&
        getAfter(target).data.uid == resource.data.uid &&
        getAfter(target).data.enabled == enabled &&
        getAfter(target).data.role == 'teacher' &&
        getAfter(target).data.updatedAt == request.time &&
        getAfter(target).data.updatedByUid == request.auth.uid;
    }

    function validTeacherSuspension(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'active' && before.enabled == true && before.role == 'teacher' &&
        isAdmin() &&
        validStoredTeacherAllowance(uid, before) && validStoredTeacherAllowance(uid, after) &&
        after.keys().hasOnly([
          'uid', 'emailCanonical', 'displayName', 'status', 'enabled', 'role',
          'administrativeHold', 'approvedAt', 'approvedByUid', 'updatedAt', 'updatedByUid',
          'suspendedAt', 'suspendedByUid', 'suspensionReason', 'revision'
        ]) &&
        after.status == 'suspended' && after.enabled == false &&
        after.administrativeHold == true &&
        after.revision == before.get('revision', 0) + 1 &&
        after.suspendedAt == request.time && after.suspendedByUid == request.auth.uid &&
        after.suspensionReason is string && after.suspensionReason.size() <= 200 &&
        after.updatedAt == request.time && after.updatedByUid == request.auth.uid &&
        validLifecycleLegacyAllowance(before.emailCanonical, false) &&
        validConsumedPublicationLifecycleLock(uid, before, 'teacher-suspension') &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'enabled', 'administrativeHold', 'revision',
          'suspendedAt', 'suspendedByUid', 'suspensionReason',
          'updatedAt', 'updatedByUid'
        ]);
    }

    function validTeacherRestore(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'suspended' && before.enabled == false && before.role == 'teacher' &&
        isAdmin() &&
        validStoredTeacherAllowance(uid, before) && validStoredTeacherAllowance(uid, after) &&
        before.keys().hasOnly([
          'uid', 'emailCanonical', 'displayName', 'status', 'enabled', 'role',
          'administrativeHold', 'approvedAt', 'approvedByUid', 'updatedAt', 'updatedByUid',
          'suspendedAt', 'suspendedByUid', 'suspensionReason', 'revision'
        ]) &&
        after.keys().hasOnly([
          'uid', 'emailCanonical', 'displayName', 'status', 'enabled', 'role',
          'administrativeHold', 'approvedAt', 'approvedByUid', 'updatedAt', 'updatedByUid',
          'revision'
        ]) &&
        after.status == 'active' && after.enabled == true && after.administrativeHold == false &&
        after.revision == before.get('revision', 0) + 1 &&
        after.updatedAt == request.time && after.updatedByUid == request.auth.uid &&
        validLifecycleLegacyAllowance(before.emailCanonical, true) &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'enabled', 'administrativeHold', 'revision',
          'suspendedAt', 'suspendedByUid', 'suspensionReason',
          'updatedAt', 'updatedByUid'
        ]);
    }

    function deletionAllowanceKeysOnly(data) {
      return data.keys().hasOnly([
        'uid', 'emailCanonical', 'displayName', 'status', 'enabled', 'role',
        'administrativeHold', 'approvedAt', 'approvedByUid', 'updatedAt', 'updatedByUid',
        'revision', 'deletionRequestedAt', 'purgeEligibleAt',
        'suspendedAt', 'suspendedByUid', 'suspensionReason'
      ]);
    }

    function ownDeletionIdentity(uid, data) {
      return verifiedEmail() && request.auth.uid == uid && data.role == 'teacher' &&
        data.uid == uid && data.emailCanonical == request.auth.token.email;
    }

    function validStoredDeletionPendingShape(uid, data) {
      return data.uid == uid && data.role == 'teacher' &&
        validStoredTeacherAllowance(uid, data) &&
        deletionAllowanceKeysOnly(data) && data.status == 'deletion_pending' &&
        data.enabled == false && data.revision is int && data.revision > 0 &&
        data.deletionRequestedAt is timestamp &&
        (!('purgeEligibleAt' in data) ||
          (data.purgeEligibleAt is timestamp &&
            data.purgeEligibleAt == data.deletionRequestedAt + duration.value(30, 'd')));
    }

    function validDeletionPendingShape(uid, data) {
      return ownDeletionIdentity(uid, data) && validStoredDeletionPendingShape(uid, data);
    }

    function validOwnTeacherDeletionRequest(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return ownDeletionIdentity(uid, before) && validStoredTeacherAllowance(uid, before) &&
        before.status == 'active' && before.enabled == true && before.role == 'teacher' &&
        before.administrativeHold == false && validDeletionPendingShape(uid, after) &&
        !('purgeEligibleAt' in after) && after.deletionRequestedAt == request.time &&
        after.revision == before.get('revision', 0) + 1 &&
        after.updatedAt == request.time && after.updatedByUid == request.auth.uid &&
        validLifecycleLegacyAllowance(before.emailCanonical, false) &&
        validConsumedPublicationLifecycleLock(uid, before, 'teacher-deletion-pending') &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'enabled', 'revision', 'deletionRequestedAt', 'purgeEligibleAt',
          'updatedAt', 'updatedByUid'
        ]);
    }

    function validOwnTeacherDeletionTimestampSettlement(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return validDeletionPendingShape(uid, before) && validDeletionPendingShape(uid, after) &&
        !('purgeEligibleAt' in before) &&
        after.purgeEligibleAt == before.deletionRequestedAt + duration.value(30, 'd') &&
        after.revision == before.revision + 1 && after.updatedAt == request.time &&
        after.updatedByUid == request.auth.uid &&
        after.diff(before).affectedKeys().hasOnly([
          'purgeEligibleAt', 'revision', 'updatedAt', 'updatedByUid'
        ]);
    }

    function validOwnTeacherDeletionCancellation(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let held = before.administrativeHold == true;
      let ownCancellation = verifiedEmail() && request.auth.uid == uid &&
        before.emailCanonical == request.auth.token.email;
      return (ownCancellation || isAdmin()) &&
        before.uid == uid && canonicalAllowanceId(before.emailCanonical) &&
        before.role == 'teacher' &&
        before.status == 'deletion_pending' && before.enabled == false &&
        before.revision is int && before.revision > 0 &&
        before.deletionRequestedAt is timestamp &&
        (!('purgeEligibleAt' in before) ||
          (before.purgeEligibleAt is timestamp &&
            before.purgeEligibleAt == before.deletionRequestedAt + duration.value(30, 'd'))) &&
        (!('purgeEligibleAt' in before) || request.time < before.purgeEligibleAt) &&
        !('deletionRequestedAt' in after) && !('purgeEligibleAt' in after) &&
        (held
          ? after.status == 'suspended' && after.enabled == false &&
            after.suspendedAt == before.suspendedAt &&
            after.suspendedByUid == before.suspendedByUid &&
            after.suspensionReason == before.suspensionReason
          : after.status == 'active' && after.enabled == true &&
            !('suspendedAt' in after) && !('suspendedByUid' in after) &&
            !('suspensionReason' in after) &&
            validLifecycleLegacyAllowance(before.emailCanonical, true)) &&
        after.revision == before.revision + 1 && after.updatedAt == request.time &&
        after.updatedByUid == request.auth.uid &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'enabled', 'revision', 'deletionRequestedAt', 'purgeEligibleAt',
          'updatedAt', 'updatedByUid'
        ]);
    }

    function validTeacherDeletionAdministrativeHold(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'deletion_pending' && before.enabled == false &&
        before.administrativeHold == false && before.uid == uid && before.role == 'teacher' &&
        before.revision is int && before.revision > 0 && before.deletionRequestedAt is timestamp &&
        after.uid == before.uid && after.emailCanonical == before.emailCanonical &&
        after.displayName == before.displayName && after.role == before.role &&
        after.administrativeHold == true && after.status == 'deletion_pending' &&
        after.enabled == false && after.deletionRequestedAt == before.deletionRequestedAt &&
        after.get('purgeEligibleAt', null) == before.get('purgeEligibleAt', null) &&
        after.revision == before.revision + 1 && after.suspendedAt == request.time &&
        after.suspendedByUid == request.auth.uid && after.suspensionReason is string &&
        after.suspensionReason.size() <= 200 && after.updatedAt == request.time &&
        after.updatedByUid == request.auth.uid &&
        validLifecycleLegacyAllowance(before.emailCanonical, false) &&
        after.diff(before).affectedKeys().hasOnly([
          'administrativeHold', 'revision', 'suspendedAt', 'suspendedByUid',
          'suspensionReason', 'updatedAt', 'updatedByUid'
        ]) && isAdmin();
    }

    function validOwnTeacherDeletionLegacyAllowance(email) {
      let allowancePath = teacherAllowancePath();
      let before = get(allowancePath).data;
      let after = getAfter(allowancePath).data;
      return verifiedEmail() && email == request.auth.token.email &&
        exists(allowancePath) && existsAfter(allowancePath) &&
        request.resource.data.keys().hasOnly(['uid', 'enabled', 'role', 'updatedAt', 'updatedByUid']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'teacher' &&
        request.resource.data.enabled == after.enabled &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedByUid == request.auth.uid &&
        before.uid == request.auth.uid && after.uid == request.auth.uid &&
        before.emailCanonical == email && after.emailCanonical == email &&
        before.role == 'teacher' && after.role == 'teacher' &&
        after.revision == before.get('revision', 0) + 1 &&
        ((before.status == 'active' && before.enabled == true &&
            after.status == 'deletion_pending' && after.enabled == false &&
            after.deletionRequestedAt == request.time) ||
          (before.status == 'deletion_pending' && before.enabled == false &&
            after.status in ['active', 'suspended'] &&
            !('deletionRequestedAt' in after) && !('purgeEligibleAt' in after)));
    }

    function validTeacherAllowanceUpdate(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'active'
        ? (after.status == 'deletion_pending'
            ? validOwnTeacherDeletionRequest(uid)
            : validAdminTeacherAllowanceMutation(uid))
        : (before.status == 'deletion_pending'
            ? (after.status in ['active', 'suspended']
                ? validOwnTeacherDeletionCancellation(uid)
                : (before.administrativeHold == false && after.administrativeHold == true
                    ? validTeacherDeletionAdministrativeHold(uid)
                    : validOwnTeacherDeletionTimestampSettlement(uid)))
            : validAdminTeacherAllowanceMutation(uid));
    }

    function teacherAccessMigrationUnlocked() {
      let path = /databases/$(database)/documents/migration_gates/teacher_access_status;
      return !exists(path) || get(path).data.get('locked', false) == false;
    }

    function teacherAccessMigrationComplete() {
      let path = /databases/$(database)/documents/migration_gates/teacher_access_status;
      let data = exists(path) ? get(path).data : {};
      return exists(path) && data.get('status', '') == 'complete' &&
        data.get('strictReady', false) == true &&
        data.get('migrationGeneration', '') is string &&
        data.get('migrationGeneration', '').size() > 0;
    }

    function validAdminSyncedLegacyAllowance(email, enabled, role) {
      let path = /databases/$(database)/documents/teacher_allowlist/$(email);
      return existsAfter(path) &&
        getAfter(path).data.keys().hasOnly(['uid', 'enabled', 'role', 'updatedAt', 'updatedByUid']) &&
        getAfter(path).data.uid == resource.data.uid &&
        getAfter(path).data.enabled == enabled && getAfter(path).data.role == role &&
        getAfter(path).data.updatedAt == request.time &&
        getAfter(path).data.updatedByUid == request.auth.uid;
    }

    function validAuthoritativeLegacyMirror(email) {
      let uid = request.resource.data.get('uid', '');
      let mirrorPath = /databases/$(database)/documents/teacher_allowlist/$(email);
      let allowancePath = /databases/$(database)/documents/teacher_allowances/$(uid);
      return signedIn() && teacherAccessMigrationUnlocked() && uid is string && uid.size() > 0 &&
        (!exists(mirrorPath) || get(mirrorPath).data.get('uid', '') in ['', uid]) &&
        request.resource.data.keys().hasOnly([
          'uid', 'enabled', 'role', 'updatedAt', 'updatedByUid'
        ]) && request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedByUid == request.auth.uid && existsAfter(allowancePath) &&
        getAfter(allowancePath).data.uid == uid &&
        getAfter(allowancePath).data.emailCanonical == email &&
        getAfter(allowancePath).data.enabled == request.resource.data.enabled &&
        getAfter(allowancePath).data.role == request.resource.data.role &&
        getAfter(allowancePath).data.updatedAt == request.time &&
        getAfter(allowancePath).data.updatedByUid == request.auth.uid;
    }

    function validAdminTeacherAllowanceMutation(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let active = after.status == 'active';
      return isAdmin() && teacherAccessMigrationUnlocked() &&
        validStoredTeacherAllowance(uid, before) && validStoredTeacherAllowance(uid, after) &&
        before.status in ['active', 'suspended'] && after.status in ['active', 'suspended'] &&
        after.uid == before.uid && after.emailCanonical == before.emailCanonical &&
        after.displayName == before.displayName && after.approvedAt == before.approvedAt &&
        after.approvedByUid == before.approvedByUid &&
        after.enabled == active && after.administrativeHold == !active &&
        after.revision == before.get('revision', 0) + 1 &&
        after.updatedAt == request.time && after.updatedByUid == request.auth.uid &&
        (uid != request.auth.uid || (after.status == 'active' && after.role == 'admin')) &&
        (active
          ? !('suspendedAt' in after) && !('suspendedByUid' in after) &&
            !('suspensionReason' in after)
          : after.suspendedAt == request.time && after.suspendedByUid == request.auth.uid &&
            after.suspensionReason is string && after.suspensionReason.size() <= 200) &&
        validAdminSyncedLegacyAllowance(before.emailCanonical, after.enabled, after.role) &&
        (active || before.status != 'active' ||
          validConsumedPublicationLifecycleLock(uid, before, 'teacher-suspension')) &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'enabled', 'role', 'administrativeHold', 'revision',
          'suspendedAt', 'suspendedByUid', 'suspensionReason', 'updatedAt', 'updatedByUid'
        ]);
    }

    function counterMigrationUnlocked() {
      let path = /databases/$(database)/documents/migration_gates/set_counters;
      return exists(path) && validStoredCounterGateUnlocked(get(path).data);
    }

    function validStoredSessionCounterGate(data) {
      return data.keys().hasAll([
          'complete', 'projectId', 'environment', 'rulesVersion',
          'preflightNonEndedLegacyCount', 'verifiedAt', 'updatedAt', 'completedByUid'
        ]) &&
        data.keys().hasOnly([
          'complete', 'projectId', 'environment', 'rulesVersion',
          'preflightNonEndedLegacyCount', 'verifiedAt', 'updatedAt', 'completedByUid'
        ]) &&
        data.complete == true &&
        data.projectId is string && data.projectId.size() > 0 && data.projectId.size() <= 120 &&
        data.environment in ['production', 'emulator'] &&
        data.rulesVersion == 'session-counters-v1' &&
        data.preflightNonEndedLegacyCount == 0 &&
        data.verifiedAt is timestamp && data.updatedAt is timestamp &&
        data.updatedAt == data.verifiedAt &&
        data.completedByUid is string && data.completedByUid.size() > 0 &&
        data.completedByUid.size() <= 128;
    }

    function sessionCounterMigrationComplete() {
      let path = /databases/$(database)/documents/migration_gates/session_counters;
      return exists(path) && validStoredSessionCounterGate(get(path).data);
    }

    function legacySessionCounterCompatibilityOpen() {
      return !sessionCounterMigrationComplete();
    }

    function sessionCounterMigrationUnlocked() {
      let path = /databases/$(database)/documents/migration_gates/session_counter_migration;
      return !exists(path) || get(path).data.get('locked', true) == false;
    }

    function validStoredCounterGateUnlocked(data) {
      return data.keys().hasAll([
          'locked', 'lockId', 'projectId', 'targetMode', 'lockedAt', 'lockedByUid',
          'unlockedAt', 'unlockedByUid'
        ]) &&
        data.keys().hasOnly([
          'locked', 'lockId', 'projectId', 'targetMode', 'lockedAt', 'lockedByUid',
          'unlockedAt', 'unlockedByUid'
        ]) &&
        data.locked == false &&
        data.lockId is string && data.lockId.size() > 0 && data.lockId.size() <= 120 &&
        data.projectId is string && data.projectId.size() > 0 && data.projectId.size() <= 120 &&
        data.targetMode in ['production', 'emulator'] &&
        data.lockedAt is timestamp && data.lockedByUid is string &&
        data.lockedByUid.size() > 0 &&
        data.unlockedAt is timestamp && data.unlockedByUid is string &&
        data.unlockedByUid.size() > 0;
    }

    function validCounterGateLock() {
      return request.resource.data.keys().hasAll([
          'locked', 'lockId', 'projectId', 'targetMode', 'lockedAt', 'lockedByUid'
        ]) &&
        request.resource.data.keys().hasOnly([
          'locked', 'lockId', 'projectId', 'targetMode', 'lockedAt', 'lockedByUid'
        ]) &&
        request.resource.data.locked == true &&
        request.resource.data.lockId is string && request.resource.data.lockId.size() > 0 &&
        request.resource.data.lockId.size() <= 120 &&
        request.resource.data.projectId is string && request.resource.data.projectId.size() > 0 &&
        request.resource.data.projectId.size() <= 120 &&
        request.resource.data.targetMode in ['production', 'emulator'] &&
        request.resource.data.lockedAt is timestamp &&
        request.resource.data.lockedAt == request.time &&
        request.resource.data.lockedByUid == request.auth.uid;
    }

    function validCounterGateUnlock() {
      return resource.data.get('locked', false) == true &&
        request.resource.data.keys().hasAll([
          'locked', 'lockId', 'projectId', 'targetMode', 'lockedAt', 'lockedByUid',
          'unlockedAt', 'unlockedByUid'
        ]) &&
        request.resource.data.keys().hasOnly([
          'locked', 'lockId', 'projectId', 'targetMode', 'lockedAt', 'lockedByUid',
          'unlockedAt', 'unlockedByUid'
        ]) &&
        request.resource.data.locked == false &&
        request.resource.data.lockId == resource.data.lockId &&
        request.resource.data.projectId == resource.data.projectId &&
        request.resource.data.targetMode == resource.data.targetMode &&
        request.resource.data.lockedAt == resource.data.lockedAt &&
        request.resource.data.lockedByUid == resource.data.lockedByUid &&
        request.resource.data.unlockedAt is timestamp &&
        request.resource.data.unlockedAt == request.time &&
        request.resource.data.unlockedByUid == request.auth.uid;
    }

    function ownsSet(setId) {
      return isApprovedTeacher() &&
        exists(/databases/$(database)/documents/quiz_sets/$(setId)) &&
        get(/databases/$(database)/documents/quiz_sets/$(setId)).data.ownerUid == request.auth.uid;
    }

    function activeSet(setId) {
      return exists(/databases/$(database)/documents/quiz_sets/$(setId)) &&
        (!('trashedAt' in get(/databases/$(database)/documents/quiz_sets/$(setId)).data) ||
          get(/databases/$(database)/documents/quiz_sets/$(setId)).data.trashedAt == null) &&
        (!('purgeStartedAt' in get(/databases/$(database)/documents/quiz_sets/$(setId)).data) ||
          get(/databases/$(database)/documents/quiz_sets/$(setId)).data.purgeStartedAt == null) &&
        (!('lifecycleState' in get(/databases/$(database)/documents/quiz_sets/$(setId)).data) ||
          get(/databases/$(database)/documents/quiz_sets/$(setId)).data.lifecycleState == 'active');
    }

    function collaboratorPath(setId) {
      return /databases/$(database)/documents/quiz_sets/$(setId)/collaborators/$(request.auth.token.email);
    }

    function collaboratorSharePath(setId, email) {
      return /databases/$(database)/documents/quiz_set_shares/$(email)/sets/$(setId);
    }

    function validStoredCollaboratorData(data, email) {
      return canonicalAllowanceId(email) &&
        data.keys().hasAll(['email', 'addedByUid', 'addedAt']) &&
        data.keys().hasOnly(['email', 'addedByUid', 'addedAt']) &&
        data.email == email && data.addedByUid is string &&
        data.addedByUid.size() >= 1 && data.addedByUid.size() <= 128 &&
        data.addedAt is timestamp;
    }

    function validCollaboratorShareData(data, setId, email) {
      return canonicalAllowanceId(email) && setId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$') &&
        data.keys().hasAll(['email', 'setId']) && data.keys().hasOnly(['email', 'setId']) &&
        data.email == email && data.setId == setId;
    }

    function validCollaboratorShareAfter(setId, email, action) {
      let path = collaboratorSharePath(setId, email);
      return action == 'add'
        ? !exists(path) && existsAfter(path) &&
          validCollaboratorShareData(getAfter(path).data, setId, email)
        : exists(path) && !existsAfter(path);
    }

    function isSetCollaborator(setId) {
      return isApprovedTeacher() && activeSet(setId) && exists(collaboratorPath(setId)) &&
        validStoredCollaboratorData(
          get(collaboratorPath(setId)).data,
          request.auth.token.email
